<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local-packages" value="packages" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="packages" />
    <add key="repositoryPath" value="packages" />
  </config>
  <packageSourceMapping>
    <packageSource key="local-packages">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
