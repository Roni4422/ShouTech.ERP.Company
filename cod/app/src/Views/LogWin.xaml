<Window x:Class="ShouTech.App.Views.LogWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ShouTech.App.Converters"
        xmlns:loc="clr-namespace:ShouTech.App.Localization"
        Title="{Binding WindowTitle}"
        Width="560" Height="330"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Tahoma"
        WindowStyle="SingleBorderWindow"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="Login">
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Height" Value="330"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HideUsernameField}" Value="True">
                    <Setter Property="Height" Value="330"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>

        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6,46,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6,46,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldValidationTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="28,10,28,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding SignInLabel}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,8"/>

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,12,18,12">
                <StackPanel Width="380" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11"
                                   Margin="0,0,0,4"
                                   AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding CompanyName}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,3"
                                   Visibility="{Binding CompanyName, Converter={StaticResource NullToVisibility}}"/>

                        <StackPanel Visibility="{Binding UsernameSectionVisibility}">
                            <TextBlock Text="{Binding UsernameLabel}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,0,2"/>
                            <TextBox x:Name="txtUsername"
                                     Width="380"
                                     HorizontalAlignment="Stretch"
                                     Padding="10,6"
                                     Style="{StaticResource LoginTextBoxStyle}"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolean}}"
                                     TabIndex="1"
                                     AutomationProperties.Name="Username"
                                     AutomationProperties.HelpText="Enter username"/>
                            <TextBlock Text="{Binding UsernameError}"
                                       Style="{StaticResource FieldValidationTextStyle}"
                                       Visibility="{Binding UsernameError, Converter={StaticResource NullToVisibility}}"
                                       AutomationProperties.Name="Username error"/>
                        </StackPanel>

                        <TextBlock Text="{Binding PasswordLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,6,0,2"/>
                        <Grid Width="380" Height="34">
                            <PasswordBox x:Name="txtPassword"
                                         Width="380"
                                         HorizontalAlignment="Stretch"
                                         Style="{StaticResource LoginPasswordBoxStyle}"
                                             Visibility="{Binding PasswordFieldVisibility}"
                                             IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolean}}"
                                             PasswordChanged="PasswordBox_PasswordChanged"
                                             TabIndex="2"
                                             AutomationProperties.Name="Password"
                                             AutomationProperties.HelpText="Enter password"/>
                            <TextBox x:Name="txtPasswordVisible"
                                     Width="380"
                                     HorizontalAlignment="Stretch"
                                     Padding="10,6,46,6"
                                     Style="{StaticResource LoginTextBoxStyle}"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding PasswordTextVisibility}"
                                         IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolean}}"
                                         TabIndex="2"
                                         AutomationProperties.Name="Password visible"/>
                            <ToggleButton Margin="0,0,4,0"
                                          Width="32"
                                          Height="32"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsPasswordVisible, Mode=TwoWay}"
                                          IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolean}}"
                                          TabIndex="3"
                                          loc:LocProps.ToolTipKey="Login.ShowHidePassword"
                                          AutomationProperties.Name="Show password">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <Path Width="17" Height="17" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"
                                                      Data="M 2,8 C 5,2 11,2 14,8 C 11,14 5,14 2,8 Z M 6,8 A 2,2 0 1 0 10,8 A 2,2 0 1 0 6,8"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryTransparentBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </Grid>

                        <TextBlock Text="{Binding PasswordError}"
                                   Style="{StaticResource FieldValidationTextStyle}"
                                   Visibility="{Binding PasswordError, Converter={StaticResource NullToVisibility}}"
                                   AutomationProperties.Name="Password error"/>

                        <CheckBox Content="{Binding HideUsernameOptionLabel}"
                                  IsChecked="{Binding HideUsernameOnNextLaunch, Mode=TwoWay}"
                                  Margin="0,6,0,0"
                                  FontSize="11"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  HorizontalAlignment="Right"
                                  IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolean}}"/>

                        <!-- LTR default: OK/SignIn left, Cancel right. Arabic swaps in code-behind. -->
                        <Grid x:Name="btnBar"
                              HorizontalAlignment="Right"
                              Width="380"
                              Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnOk"
                                    Grid.Column="0"
                                    Content="{Binding SignInLabel}"
                                    Height="32"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding LoginCommand}"
                                    IsDefault="True"
                                    TabIndex="4"
                                    AutomationProperties.Name="Sign in"/>
                            <Button x:Name="btnCancel"
                                    Grid.Column="2"
                                    Content="{Binding CancelLabel}"
                                    Height="32"
                                    FontSize="12"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding CancelCommand}"
                                    IsCancel="True"
                                    TabIndex="5"
                                    AutomationProperties.Name="Cancel"/>
                        </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Loading overlay -->
        <Border Background="#B3000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Loading">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Width="220"
                             Height="4"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource PrimaryBrush}"
                             Background="{DynamicResource SurfaceDarkBrush}"
                             BorderThickness="0"/>
                <TextBlock Text="Verifying..."
                           Margin="0,14,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
