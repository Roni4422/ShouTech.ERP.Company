<views:BaseWin x:Class="ShouTech.App.Views.WhsWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ShouTech.App.Views"
        Title="Warehouse Card"
        Width="780" Height="520"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource ApplicationFontFamily}"
        FontSize="{DynamicResource ApplicationFontSize}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!--
        ShouTech ERP - Warehouse Card (v2)
        Root element is BaseWin (not Window) so the partial class base matches code-behind.
        All user-visible strings are applied at runtime via ApplyLocalizedText / T().
        Visual tokens come exclusively from Themes/VisuId.xaml.
        Data contract: MatRepo.WarehouseRec + warehouses table.
    -->

    <views:BaseWin.Resources>
        <Style x:Key="VisuFieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="VisuCodeBoxStyle" TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource VisuTextBoxStyle}">
            <Setter Property="Height" Value="{DynamicResource SmallControlHeight}"/>
        </Style>
        <Style x:Key="VisuAutoCodeBoxStyle" TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource VisuTextBoxStyle}">
            <Setter Property="Height" Value="{DynamicResource SmallControlHeight}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="VisuNavBtnStyle" TargetType="{x:Type Button}"
               BasedOn="{StaticResource VisuButtonStyle}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Height" Value="{DynamicResource SmallControlHeight}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </views:BaseWin.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Code navigator: [First][Prev] CODE [Next][Last] — left aligned -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LblAutoCode"
                               Style="{DynamicResource VisuFieldLabelStyle}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>

                    <!-- First + Previous (left side) -->
                    <Button x:Name="BtnFirst"
                            Style="{DynamicResource VisuNavBtnStyle}"
                            Click="First_Click"
                            ToolTip="">
                        <Path Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Data="M 10,3 L 4,9 L 10,15 M 16,3 L 10,9 L 16,15"/>
                    </Button>
                    <Button x:Name="BtnPrev"
                            Style="{DynamicResource VisuNavBtnStyle}"
                            Click="Prev_Click"
                            ToolTip="">
                        <Path Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Data="M 12,3 L 5,9 L 12,15"/>
                    </Button>

                    <!-- Warehouse code (centered, bold, Western digits, -25% width) -->
                    <TextBox x:Name="TxtAutoCode"
                             Style="{DynamicResource VisuAutoCodeBoxStyle}"
                             Width="90"
                             IsReadOnly="True"
                             IsTabStop="False"
                             Margin="4,0"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"/>

                    <!-- Next + Last (right side) -->
                    <Button x:Name="BtnNext"
                            Style="{DynamicResource VisuNavBtnStyle}"
                            Click="Next_Click"
                            ToolTip="">
                        <Path Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Data="M 5,3 L 12,9 L 5,15"/>
                    </Button>
                    <Button x:Name="BtnLast"
                            Style="{DynamicResource VisuNavBtnStyle}"
                            Click="Last_Click"
                            ToolTip="">
                        <Path Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Data="M 4,3 L 10,9 L 4,15 M 10,3 L 16,9 L 10,15"/>
                    </Button>

                    <TextBlock x:Name="TxtPosition"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               MinWidth="48"
                               TextAlignment="Center"/>
                </StackPanel>

                <Border x:Name="ModeBadge"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="10"
                        Padding="12,4"
                        Background="{DynamicResource AccentLight}">
                    <TextBlock x:Name="TxtMode"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentDark}"
                               VerticalAlignment="Center"/>
                </Border>


                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="LblAdvanced"
                               Style="{DynamicResource VisuFieldLabelStyle}"
                               Margin="0,0,8,0"/>
                    <ToggleButton x:Name="TglAdvanced"
                                  Width="48" Height="26"
                                  Checked="Advanced_Toggled"
                                  Unchecked="Advanced_Toggled">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Track"
                                        Width="48" Height="26"
                                        CornerRadius="13"
                                        Background="{DynamicResource BorderBrush}">
                                    <Border x:Name="Knob"
                                            Width="20" Height="20"
                                            CornerRadius="10"
                                            Background="White"
                                            HorizontalAlignment="Left"
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Center">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="KnobShift" X="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Track" Property="Background"
                                                Value="{DynamicResource AccentPrimary}"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="KnobShift"
                                                        Storyboard.TargetProperty="X"
                                                        To="22" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="KnobShift"
                                                        Storyboard.TargetProperty="X"
                                                        To="0" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="6,4,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{DynamicResource VisuSectionCardStyle}"
                    Margin="0" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            Padding="8,5"
                            CornerRadius="8,8,0,0">
                        <TextBlock x:Name="LblTreeTitle"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </Border>
                    <TreeView x:Name="TreeWhs"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="6,4"
                              SelectedItemChanged="TreeWhs_SelectedItemChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ContextMenu>
                            <ContextMenu x:Name="TreeCtxMenu" Opened="TreeCtxMenu_Opened">
                                <MenuItem x:Name="CtxEdit"
                                          Click="CtxEdit_Click"/>
                                <MenuItem x:Name="CtxDelete"
                                          Click="CtxDelete_Click"/>
                                <Separator/>
                                <MenuItem x:Name="CtxStockCount"
                                          Click="CtxStockCount_Click"/>
                                <MenuItem x:Name="CtxStockAdjust"
                                          Click="CtxStockAdjust_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel>
                    <Border Style="{DynamicResource VisuSectionCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="LblCardNo" Grid.Row="0" Grid.Column="0"
                                       Style="{DynamicResource VisuFieldLabelStyle}"/>
                            <TextBox x:Name="TxtCardNo" Grid.Row="0" Grid.Column="1"
                                     Style="{DynamicResource VisuCodeBoxStyle}"
                                     MaxLength="12"
                                     TextChanged="Field_Changed"/>

                            <TextBlock x:Name="LblName" Grid.Row="1" Grid.Column="0"
                                       Style="{DynamicResource VisuFieldLabelStyle}"/>
                            <TextBox x:Name="TxtName" Grid.Row="1" Grid.Column="1"
                                     Style="{DynamicResource VisuTextBoxStyle}"
                                     MaxLength="200"
                                     TextChanged="Field_Changed"/>

                            <TextBlock x:Name="LblNameEn" Grid.Row="2" Grid.Column="0"
                                       Style="{DynamicResource VisuFieldLabelStyle}"/>
                            <TextBox x:Name="TxtNameEn" Grid.Row="2" Grid.Column="1"
                                     Style="{DynamicResource VisuTextBoxStyle}"
                                     MaxLength="200"
                                     FlowDirection="LeftToRight"
                                     TextAlignment="Left"
                                     Language="en-US"
                                     TextChanged="Field_Changed"/>

                            <TextBlock x:Name="LblParent" Grid.Row="3" Grid.Column="0"
                                       Style="{DynamicResource VisuFieldLabelStyle}"/>
                            <Border Grid.Row="3" Grid.Column="1"
                                    Background="{DynamicResource FieldBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <ComboBox x:Name="CmbParent"
                                          Style="{DynamicResource VisuComboBoxStyle}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Height="28"
                                          DisplayMemberPath="Display"
                                          SelectionChanged="Field_Changed"/>
                            </Border>

                            <StackPanel Grid.Row="4" Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="0,2,0,4">
                                <CheckBox x:Name="ChkDefault"
                                          Margin="0,0,20,0"
                                          FontSize="12"
                                          Foreground="{DynamicResource TextPrimary}"
                                          Checked="Field_Changed"
                                          Unchecked="Field_Changed"/>
                                <CheckBox x:Name="ChkActive"
                                          FontSize="12"
                                          Foreground="{DynamicResource TextPrimary}"
                                          IsChecked="True"
                                          Checked="Field_Changed"
                                          Unchecked="Field_Changed"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtFieldError"
                                       Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                       FontSize="11"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Margin="0,2,0,0"/>
                        </Grid>
                    </Border>

                    <Border x:Name="PnlAdvanced"
                            Style="{DynamicResource VisuSectionCardStyle}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="LblAddress" Grid.Row="0" Grid.Column="0"
                                       Style="{DynamicResource VisuFieldLabelStyle}"/>
                            <TextBox x:Name="TxtAddress" Grid.Row="0" Grid.Column="1"
                                     Style="{DynamicResource VisuTextBoxStyle}"
                                     MaxLength="300"
                                     TextChanged="Field_Changed"/>

                            <TextBlock x:Name="LblCity" Grid.Row="1" Grid.Column="0"
                                       Style="{DynamicResource VisuFieldLabelStyle}"/>
                            <TextBox x:Name="TxtCity" Grid.Row="1" Grid.Column="1"
                                     Style="{DynamicResource VisuTextBoxStyle}"
                                     MaxLength="100"
                                     TextChanged="Field_Changed"/>

                            <TextBlock x:Name="LblRegion" Grid.Row="2" Grid.Column="0"
                                       Style="{DynamicResource VisuFieldLabelStyle}"/>
                            <TextBox x:Name="TxtRegion" Grid.Row="2" Grid.Column="1"
                                     Style="{DynamicResource VisuTextBoxStyle}"
                                     MaxLength="100"
                                     TextChanged="Field_Changed"/>

                            <TextBlock x:Name="LblCountry" Grid.Row="3" Grid.Column="0"
                                       Style="{DynamicResource VisuFieldLabelStyle}"/>
                            <TextBox x:Name="TxtCountry" Grid.Row="3" Grid.Column="1"
                                     Style="{DynamicResource VisuTextBoxStyle}"
                                     MaxLength="100"
                                     TextChanged="Field_Changed"/>

                            <TextBlock x:Name="LblPhone" Grid.Row="4" Grid.Column="0"
                                       Style="{DynamicResource VisuFieldLabelStyle}"/>
                            <TextBox x:Name="TxtPhone" Grid.Row="4" Grid.Column="1"
                                     Style="{DynamicResource VisuCodeBoxStyle}"
                                     MaxLength="50"
                                     TextChanged="Field_Changed"/>

                            <TextBlock x:Name="LblLocation" Grid.Row="5" Grid.Column="0"
                                       Style="{DynamicResource VisuFieldLabelStyle}"/>
                            <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtAisle" Grid.Column="0"
                                         Style="{DynamicResource VisuCodeBoxStyle}" Margin="0"
                                         MaxLength="30" TextChanged="Field_Changed"/>
                                <TextBox x:Name="TxtRack" Grid.Column="2"
                                         Style="{DynamicResource VisuCodeBoxStyle}" Margin="0"
                                         MaxLength="30" TextChanged="Field_Changed"/>
                                <TextBox x:Name="TxtShelf" Grid.Column="4"
                                         Style="{DynamicResource VisuCodeBoxStyle}" Margin="0"
                                         MaxLength="30" TextChanged="Field_Changed"/>
                            </Grid>

                            <TextBlock x:Name="LblNotes" Grid.Row="6" Grid.Column="0"
                                       Style="{DynamicResource VisuFieldLabelStyle}"
                                       VerticalAlignment="Top" Margin="0,6,10,0"/>
                            <TextBox x:Name="TxtNotes" Grid.Row="6" Grid.Column="1"
                                     Style="{DynamicResource VisuTextBoxStyle}"
                                     Height="72"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     Padding="8,6"
                                     MaxLength="1000"
                                     TextChanged="Field_Changed"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnNew"
                            Style="{DynamicResource VisuSecondaryButtonStyle}"
                            MinWidth="80" Margin="0,0,6,0"
                            Click="New_Click"/>
                    <Button x:Name="BtnEdit"
                            Style="{DynamicResource VisuSecondaryButtonStyle}"
                            MinWidth="80" Margin="0,0,6,0"
                            Click="Edit_Click" IsEnabled="False"/>
                    <Button x:Name="BtnSave"
                            Style="{DynamicResource VisuAccentButtonStyle}"
                            MinWidth="88" Margin="0,0,6,0"
                            Click="Save_Click" IsEnabled="False"/>
                    <Button x:Name="BtnDelete"
                            Style="{DynamicResource VisuSecondaryButtonStyle}"
                            MinWidth="80" Margin="0,0,6,0"
                            Click="Delete_Click" IsEnabled="False"/>
                    <Button x:Name="BtnClose"
                            Style="{DynamicResource VisuSecondaryButtonStyle}"
                            MinWidth="80"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:BaseWin>
