            <Border Grid.Row="4"
                    Background="{DynamicResource ShellContentBackgroundBrush}"
                    BorderBrush="{DynamicResource ShellContentBorderBrush}"
                    BorderThickness="0"
                    CornerRadius="0"
                    Margin="0">
                <ContentControl Content="{Binding CurrentContent}"/>
            </Border>

            
            <Border x:Name="InternalWindowDock"
                    Grid.Row="5"
                    Margin="8,2,8,4"
                    Height="58"
                    Background="Transparent"
                    BorderBrush="{DynamicResource ShellContentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="Collapsed"
                    ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding DockedWindows}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas ClipToBounds="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                            <Setter Property="Canvas.Top" Value="4"/>
                            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.RestoreDockedWindowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Width="{Binding ItemWidth}"
                                    Height="48"
                                    Padding="10,4"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Background="{DynamicResource ShellBackgroundBrush}"
                                    Foreground="{DynamicResource TextBrush}"
                                    BorderBrush="{DynamicResource ShellContentBorderBrush}"
                                    BorderThickness="1"
                                    ToolTip="Restore window">
                                <TextBlock Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            
            <StatusBar x:Name="MainStatusBar" Grid.Row="6"
                       Background="{DynamicResource ShellStatusBarBackgroundBrush}"
                       Foreground="{DynamicResource ShellStatusBarForegroundBrush}"
                       Height="26"
					   FlowDirection="LeftToRight">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal"
								FlowDirection="LeftToRight">
                        <TextBlock Text="Company: " Opacity="0.78" Margin="0,0,3,0"/>
                        <TextBlock Text="{Binding CompanyName}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal"
								FlowDirection="LeftToRight">
                        <TextBlock Text="User: " Opacity="0.78" Margin="0,0,3,0"/>
                        <TextBlock Text="{Binding CurrentUser}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal"
								FlowDirection="LeftToRight">
                        <TextBlock Text="Database: " Opacity="0.78" Margin="0,0,3,0"/>
                        <TextBlock Text="{Binding CurrentDatabase}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem x:Name="BinStatusItem"
                               HorizontalAlignment="Left"
                               HorizontalContentAlignment="Left">
                    <Button x:Name="RecycleBinButton"
                            Style="{StaticResource RecycleBinIconButtonStyle}"
                            ToolTip="Archive bin"
                            Width="36"
                            Height="30"
                            Margin="6,0,8,0"
                            Click="OnRecycleBinClick">
                        <Image Width="24" Height="24"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/Resources/Ico/ArchiveBin.png"/>
                    </Button>
                </StatusBarItem>
            </StatusBar>

            <!-- Archive bin: LTR Canvas so RTL shell does not mirror screen sides -->
            <Canvas x:Name="RecycleBinLayer"
                    Grid.Row="4"
                    Grid.RowSpan="3"
                    FlowDirection="LeftToRight"
                    
                    IsHitTestVisible="True"
                    Panel.ZIndex="50"
                    SizeChanged="RecycleBinLayer_SizeChanged">
                <Button x:Name="RecycleBinCornerButton"
                        Style="{StaticResource RecycleBinIconButtonStyle}"
                        ToolTip="Archive bin"
                        Width="120"
                        Height="130"
                        Canvas.Left="24"
                        Canvas.Bottom="24"
                        Click="OnRecycleBinClick">
                    <Grid Width="120" Height="130">
                        <Image Width="130"
                               Height="130"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Center"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/Resources/Ico/ArchiveBin.png"/>
               </Border>
                    </Grid>
                </Button>
            </Canvas>
        </Grid>
    </Border>
</ribbon:RibbonWindow>