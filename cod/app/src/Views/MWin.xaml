<ribbon:RibbonWindow x:Class="ShouTech.App.Views.MWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:ShouTech.App.Localization"
        Title="ShouTech"
        WindowStyle="None"
        ResizeMode="CanResize"
        Height="700"
        Width="1200"
        MinWidth="600"
        MinHeight="120"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Tahoma"
        FontSize="14"
        Background="{DynamicResource ShellUnifiedLightBrush}"
        Foreground="{DynamicResource TextBrush}"
        StateChanged="OnWindowStateChanged">



    <ribbon:RibbonWindow.Resources>

        <!-- Transparent hit-target for archive-bin image (no square chrome) -->
        <Style x:Key="RecycleBinIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.92"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RadioPanelVisibility" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Minimized">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ribbon:RibbonWindow.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="14"
            ClipToBounds="True"
            Background="{DynamicResource ShellUnifiedLightBrush}"
            SnapsToDevicePixels="True">
        <Grid Background="{DynamicResource ShellUnifiedLightBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            
            <Border Grid.Row="0"
                    Background="{DynamicResource ShellUnifiedLightBrush}"
                    HorizontalAlignment="Stretch"
                    Margin="0"
                    Padding="0">
                <Grid x:Name="WindowChromeBar"
                      Height="28"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource ChromeBackgroundBrush}"
                      FlowDirection="LeftToRight"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True"
                      MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="Transparent"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Margin="0">
                        <Button x:Name="MinimizeButton"
								shell:WindowChrome.IsHitTestVisibleInChrome="True"
								Style="{StaticResource WindowChromeButtonStyle}"
								Content="─"
								ToolTip="Minimize"
								Background="{DynamicResource ChromeBackgroundBrush}"
								Foreground="{DynamicResource ChromeForegroundBrush}"
								Click="OnMinimizeClick"/>
						<Button x:Name="MaximizeButton"
								shell:WindowChrome.IsHitTestVisibleInChrome="True"
								Style="{StaticResource WindowChromeButtonStyle}"
								Content="□"
								ToolTip="Maximize"
								Background="{DynamicResource ChromeBackgroundBrush}"
								Foreground="{DynamicResource ChromeForegroundBrush}"
								Click="OnMaximizeClick"/>
						<!-- Radio panel shown only when window is minimized -->
						<StackPanel x:Name="RadioPanel" Orientation="Horizontal" Margin="5"
									Style="{StaticResource RadioPanelVisibility}">
							<RadioButton Content="Option 1"/>
							<RadioButton Content="Option 2"/>
							<RadioButton Content="Option 3"/>
						</StackPanel>
						<Button x:Name="CloseButton"
								shell:WindowChrome.IsHitTestVisibleInChrome="True"
								Style="{StaticResource WindowChromeCloseButtonStyle}"
								Content="×"
								ToolTip="Close"
								Background="{DynamicResource ChromeBackgroundBrush}"
								Foreground="{DynamicResource ChromeForegroundBrush}"
								Click="OnCloseClick"/>
						</StackPanel>
					</Grid>
				</Border>

            
            <Menu x:Name="MainMenu" Grid.Row="1"
                  Background="Transparent"
                  Foreground="{DynamicResource ShellMenuForegroundBrush}"
                  Height="34"
                  Padding="4,0"
                  ClipToBounds="True">
                <Menu.Resources>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="FontFamily" Value="Tahoma"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Margin" Value="1,0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource ShellMenuForegroundBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ShellRibbonHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Menu.Resources>
                <Menu.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Menu.ItemsPanel>
                <MenuItem x:Name="MenuFile" Header="File" Click="OnMenuFileClick"/>
                <MenuItem x:Name="MenuInventory" Header="Inventory" Click="OnMenuInventoryClick"/>
                <MenuItem x:Name="MenuAccounts" Header="Accounts" Click="OnMenuAccountsClick"/>
                <MenuItem x:Name="MenuBonds" Header="Bonds" Click="OnMenuBondsClick"/>
                <MenuItem x:Name="MenuInvoices" Header="Invoices" Click="OnMenuInvoicesClick"/>
                <MenuItem x:Name="MenuPOS" Header="Point of Sale" Click="OnMenuPOSClick"/>
                <MenuItem x:Name="MenuOrders" Header="Orders" Click="OnMenuOrdersClick"/>
                <MenuItem x:Name="MenuCustomers" Header="Customers" Click="OnMenuCustomersClick"/>
                <MenuItem x:Name="MenuSalesRep" Header="Sales Representative" Click="OnMenuSalesRepClick"/>
                <MenuItem x:Name="MenuManufacturing" Header="Manufacturing" Click="OnMenuManufacturingClick"/>
                <MenuItem x:Name="MenuBanks" Header="Banks" Click="OnMenuBanksClick"/>
                <MenuItem x:Name="MenuReports" Header="Reports" Click="OnMenuReportsClick"/>
                <MenuItem x:Name="MenuTools" Header="Tools" Click="OnMenuToolsClick"/>
                <MenuItem x:Name="MenuOtherTools" Header="Other Tools" Click="OnMenuOtherToolsClick"/>
                <MenuItem x:Name="MenuView" Header="View" Click="OnMenuViewClick"/>
                <MenuItem x:Name="MenuExit" Header="Exit" Click="OnMenuExitClick"/>
                <MenuItem x:Name="MenuHelp" Header="Help" Click="OnMenuHelpClick"/>
            </Menu>

            
            <ToolBar x:Name="MainToolBar" Grid.Row="2"
                     Background="Transparent"
                     Height="32"
                     ToolBarTray.IsLocked="True">
                <ToolBar.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Margin" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ShellRibbonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToolBar.Resources>
                <Button Content="💾" Margin="2" ToolTip="Save" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding SaveCommand}"/>
                <Button Content="↩️" Margin="2" ToolTip="Undo" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding UndoCommand}"/>
                <Button Content="↪️" Margin="2" ToolTip="Redo" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding RedoCommand}"/>
                <Button Content="🖨️" Margin="2" ToolTip="Print" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding PrintCommand}"/>
                <Button Content="🔍" Margin="2" ToolTip="Search" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding FindCommand}"/>
                <Button Content="⚙️" Margin="2" ToolTip="Settings" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding SettingsCommand}"/>
                <Button Content="📊" Margin="2" ToolTip="Reports" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding ReportsCommand}"/>
                <Button Content="📥" Margin="2" ToolTip="Import" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding ImportCommand}"/>
                <Button Content="📤" Margin="2" ToolTip="Export" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding ExportCommand}"/>
                <Button x:Name="AccentPickerButton"
                        Margin="2"
                        Width="32"
                        Height="28"
                        ToolTip="Accent color"
                        Background="Transparent"
                        Foreground="{DynamicResource TextBrush}"
                        Cursor="Hand"
                        Click="OnAccentPickerClick">
                    <Button.Content>
                        <Border Width="18" Height="18"
                                CornerRadius="3"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource AccentPrimary}"/>
                    </Button.Content>
                </Button>
                
                <Button Content="🚪" Margin="2" ToolTip="Exit" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding ExitCommand}"/>
            </ToolBar>

            
            <ribbon:Ribbon Grid.Row="3" x:Name="RibbonControl"
                           Background="Transparent"
                           Foreground="{DynamicResource ShellRibbonForegroundBrush}"
                           Visibility="Collapsed"
                           IsMinimized="False">

                <ribbon:RibbonTab x:Name="TabFile" Header="File" Visibility="Collapsed">
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.FileOperations" Header="Operations">
                        <ribbon:RibbonButton loc:LocProps.Key="Menu.New" Label="New" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton x:Name="RibbonOpenCompanyButton" loc:LocProps.Key="Menu.Open" Label="Open" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton x:Name="RibbonImportDataButton" loc:LocProps.Key="Menu.Import" Label="Import data" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton x:Name="RibbonExportDataButton" loc:LocProps.Key="Menu.Export" Label="Export data" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.FileBackup" Header="Backup">
                        <ribbon:RibbonButton x:Name="RibbonBackupButton" loc:LocProps.Key="Tools.Backup" Label="Backup" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton x:Name="RibbonRestoreBackupButton" loc:LocProps.Key="RestoreCompany.Restore" Label="Restore backup" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.FileExit" Header="Exit">
                        <ribbon:RibbonButton x:Name="RibbonExitButton" loc:LocProps.Key="Menu.Exit" Label="Exit" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                </ribbon:RibbonTab>

                <ribbon:RibbonTab x:Name="TabInventory" Header="Inventory" Visibility="Collapsed">
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.InventoryCards" Header="Cards">
                        <ribbon:RibbonButton x:Name="RibbonMaterialCardButton" loc:LocProps.Key="Inventory.MaterialCard" Label="Material card" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton x:Name="RibbonCategoryCardButton" loc:LocProps.Key="Inventory.CategoryCard" Label="Category card" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton x:Name="RibbonWarehouseCardButton" loc:LocProps.Key="Inventory.WarehouseCard" Label="Warehouse card" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton x:Name="RibbonMaterialGroupsButton" loc:LocProps.Key="Inventory.MaterialGroups" Label="مجموعات المواد" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.InventoryBarcode" Header="Barcode">
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.GenerateBarcode" Label="Generate barcode" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.DesignBarcode" Label="Design and print barcode" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.CreateBarcode" Label="Create barcode" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.InventoryMovements" Header="Movements">
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.PriceList" Label="Price list" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.EndOfPeriod" Label="End of period stock" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.ShortageList" Label="Shortage list" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.TransferMaterial" Label="Transfer material movement" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.InventoryAdjustment" Label="Inventory adjustment" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.InventoryMaterialReports" Header="Material reports">
                        <ribbon:RibbonButton x:Name="RibbonMaterialTreeButton" loc:LocProps.Key="Inventory.MaterialTree" Label="دليل المواد" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.SearchMaterial" Label="Search materials" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.WarehouseInventory" Label="Warehouse inventory" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.MaterialMovement" Label="Material movement" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.MaterialMovementChart" Label="Material movement chart" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.ExpiredMaterials" Label="Expired materials" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.InvoiceAge" Label="Invoice aging" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.MaterialProfits" Label="Material profits" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.MaterialPriceHistory" Label="Material price history" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.ServiceMaterials" Label="Service materials reports" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.MaterialStatistics" Label="Material statistics" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.StagnantMaterials" Label="Stagnant materials" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.MostActiveMaterials" Label="Most active materials" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.MaterialComparison" Label="Material comparison" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.MaterialList" Label="Material list" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.MaterialGroupMovementReport" Label="Material and group movement report" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.NegativeOutput" Label="Negative output" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.InventoryOther" Header="Other">
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.Customers" Label="Customers and material intersection" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.SerialNumbersReport" Label="Serial numbers report" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.EditSerialNumber" Label="Edit serial number" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.BranchMaterials" Label="Branch materials" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.SalesReport" Label="Sales report" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.EditMaterialSpecs" Label="Edit material specs" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Inventory.MaterialDiscounts" Label="Material discounts" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                </ribbon:RibbonTab>

                <ribbon:RibbonTab x:Name="TabAccounts" Header="Accounts" Visibility="Collapsed">
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.AccountsGeneral" Header="General">
                        <ribbon:RibbonButton x:Name="RibbonChartOfAccountsButton" loc:LocProps.Key="Accounts.ChartOfAccounts" Label="Chart of accounts" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton x:Name="RibbonAccountCardButton" loc:LocProps.Key="AccountCard" Label="Account card" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.CostCenter" Label="Cost center" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.CostCenterCard" Label="Cost center card" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.LinkWithAccounts" Label="Link to accounts" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.CostCenterReport" Label="Cost center report" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.CostCenterMaterialMovement" Label="Cost center material movement" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.CostCenterBalance" Label="Cost center trial balance" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.AccountsCurrencies" Header="Currencies">
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.DefineCurrency" Label="Define currency" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.CurrencyRates" Label="Currency rates bulletin" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.AverageCurrencyRate" Label="Average currency rates" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.ExchangeRateDifferences" Label="Exchange rate differences" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.AccountsReports" Header="Reports">
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.Ledger" Label="General ledger" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.CustomerStatement" Label="Customer statement" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.GeneralJournal" Label="General journal" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.DailyReport" Label="Daily report" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.AccountMovementChart" Label="Account movement chart" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.AccountBalance" Label="Account balance" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.BranchAccountMovement" Label="Branch account movement" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.TrialBalance" Label="Trial balance" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.AccountsClosingAccounts" Header="Closing accounts">
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.Operations" Label="Operations" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.Trading" Label="Trading" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.ProfitLoss" Label="Profit and loss" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.AccountsFinancialStatements" Header="Financial statements">
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.BalanceSheet" Label="Balance sheet" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.IncomeStatement" Label="Income statement" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.CashFlowStatement" Label="Cash flow statement" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.AccountsAnalysis" Header="Analysis">
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.DormantAccounts" Label="Inactive accounts" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.AgingReceivables" Label="Receivables aging" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.CollectionRates" Label="Collection ratios" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.AccountComparison" Label="Account comparison" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.FinancialAnalysis" Label="Local financial analysis" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Accounts.FinancialAnalysis" Label="AI financial analysis" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                </ribbon:RibbonTab>

                <ribbon:RibbonTab x:Name="TabBonds" Header="Bonds" Visibility="Collapsed">
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.BondsVouchers" Header="Vouchers">
                        <ribbon:RibbonButton loc:LocProps.Key="Bonds.JournalVoucher" Label="Journal voucher" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Bonds.ReceiptVoucher" Label="Receipt voucher" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Bonds.PaymentVoucher" Label="Payment voucher" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Bonds.JournalVoucher" Label="Daily voucher" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Bonds.CashJournal" Label="Cash journal" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Bonds.DefineVoucherTypes" Label="Define voucher patterns" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.BondsInstallments" Header="Installments">
                        <ribbon:RibbonButton loc:LocProps.Key="Bonds.Installment" Label="Installments" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Bonds.SearchInstallment" Label="Search installments" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.BondsNegotiableInstruments" Header="Negotiable instruments">
                        <ribbon:RibbonButton loc:LocProps.Key="Bonds.ReceiptCheque" Label="Incoming check" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Bonds.PaymentCheque" Label="Outgoing check" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Bonds.DefineSecurities" Label="Define negotiable instruments" Click="OnRibbonButtonClick"/>
                        <ribbon:RibbonButton loc:LocProps.Key="Bonds.SearchSecurities" Label="Search negotiable instruments" Click="OnRibbonButtonClick"/>
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup loc:LocProps.Key="RibbonGroups.BondsPayments" Header="Payments">
                        <ribbon:RibbonButton loc:LocProps.Key="Bonds.PaymentTypes" Label="Payment patterns" Click="OnRibbonButtonClick"/>
