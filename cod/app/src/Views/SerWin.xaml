<local:BaseWin x:Class="ShouTech.App.Views.SerWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShouTech.App.Views"
        Title="Search"
        Width="640"
        Height="430"
        MinWidth="520"
        MinHeight="340"
        MaxWidth="900"
        MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AccentLight}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="12"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search box -->
        <TextBox x:Name="TxtSearch"
                 Grid.Row="0"
                 Height="30"
                 Padding="8,0"
                 FontSize="13"
                 VerticalContentAlignment="Center"
                 Background="{DynamicResource FieldBackground}"
                 BorderBrush="{DynamicResource AccentPrimary}"
                 BorderThickness="2"
                 Foreground="{DynamicResource TextPrimary}"
                 Margin="0,0,0,8"
                 TextChanged="TxtSearch_TextChanged"
                 KeyDown="TxtSearch_KeyDown"/>

        <!-- Results -->
        <DataGrid x:Name="DgResults"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{DynamicResource FieldBackground}"
                  Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="{DynamicResource FieldBorder}"
                  BorderThickness="1"
                  RowBackground="{DynamicResource FieldBackground}"
                  AlternatingRowBackground="{DynamicResource PanelBackground}"
                  HorizontalGridLinesBrush="{DynamicResource FieldBorder}"
                  RowHeight="26"
                  ColumnHeaderHeight="28"
                  FontSize="12"
                  Language="en-US"
                  MouseDoubleClick="DgResults_MouseDoubleClick"
                  KeyDown="DgResults_KeyDown">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource AccentLight}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentDark}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,0"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="6,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
                    <Style.Triggers>
                        <Trigger Property="AlternationIndex" Value="1">
                            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentDark}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button x:Name="BtnOk"
                    MinWidth="90"
                    Height="30"
                    Margin="0,0,6,0"
                    Padding="14,0"
                    FontWeight="SemiBold"
                    Background="{DynamicResource AccentPrimary}"
                    Foreground="White"
                    BorderBrush="{DynamicResource AccentDark}"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="BtnOk_Click"/>

            <Button x:Name="BtnCancel"
                    MinWidth="90"
                    Height="30"
                    Padding="14,0"
                    Background="{DynamicResource FieldBackground}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource FieldBorder}"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</local:BaseWin>
