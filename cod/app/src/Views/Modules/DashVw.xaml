<UserControl x:Class="ShouTech.App.Views.Modules.DashVw"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:loc="clr-namespace:ShouTech.App.Localization"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          mc:Ignorable="d"
          d:DesignHeight="500"
          d:DesignWidth="900">


<ScrollViewer VerticalScrollBarVisibility="Auto"
              Padding="24">

    <StackPanel>

        <TextBlock Text="🏢"
                   FontSize="56"
                   HorizontalAlignment="Center"/>

        <TextBlock loc:LocProps.Key="Shell.AppName"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,4"/>

        <TextBlock loc:LocProps.Key="Shell.EnterpriseEdition"
                   FontSize="16"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"/>

        <TextBlock loc:LocProps.Key="Shell.SelectTabHint"
                   FontSize="14"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,24"/>

        <UniformGrid Columns="3"
                     Margin="0,0,0,16">

            <!-- Customers -->

            <Border Background="{DynamicResource ModuleCardBackgroundBrush}"
                    BorderBrush="{DynamicResource ModuleCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="6">

                <StackPanel>

                    <TextBlock loc:LocProps.Key="Dashboard.TotalCustomers"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"/>

                    <TextBlock x:Name="CustomersCount"
                               Text="—"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>

            <!-- Products -->

            <Border Background="{DynamicResource ModuleCardBackgroundBrush}"
                    BorderBrush="{DynamicResource ModuleCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="6">

                <StackPanel>

                    <TextBlock loc:LocProps.Key="Dashboard.TotalProducts"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"/>

                    <TextBlock x:Name="ProductsCount"
                               Text="—"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryBrush}"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>

            <!-- Pending approvals -->

            <Border Background="{DynamicResource ModuleCardBackgroundBrush}"
                    BorderBrush="{DynamicResource ModuleCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="6">

                <StackPanel>

                    <TextBlock loc:LocProps.Key="Dashboard.PendingApprovals"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"/>

                    <TextBlock x:Name="PendingCount"
                               Text="—"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource WarningBrush}"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>

        </UniformGrid>

    </StackPanel>

</ScrollViewer>


</UserControl>
