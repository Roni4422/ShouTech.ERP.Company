<local:BaseWin x:Class="ShouTech.App.Views.CatWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShouTech.App.Views"
        xmlns:loc="clr-namespace:ShouTech.App.Localization"
        Title="Category Card"
        loc:LocProps.WindowKey="CatWin.Title"
        Width="480"
        Height="550"
        MinWidth="400"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F6F8"
        FontFamily="Segoe UI"
        FontSize="11"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        Category card — enterprise input window.
        Window flow direction follows UI language (RTL for Arabic only).
        Visible captions come from Resources/Lang/*.json via Loc / UiLoczr.
        Code and Latin-name fields stay LTR always (FieldBoxLtr).
    -->

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0C4C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldBoxLtr" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0C4C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#ECEFF2" BorderBrush="#D0D5DA" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LblAutoNo" Grid.Column="0" Text="Auto No." loc:LocProps.Key="CatWin.AutoNo"
                           Style="{StaticResource FieldLabel}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtCardNo" Grid.Column="1" Width="80" Style="{StaticResource FieldBoxLtr}" Margin="0"
                         IsReadOnly="True" Background="#F0F2F4" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>

                <Grid Grid.Column="3" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBox x:Name="TxtSearch" Height="24" Padding="28,2,8,2" FontSize="11"
                             VerticalContentAlignment="Center" Background="White" BorderBrush="#C0C4C8" BorderThickness="1"
                             loc:LocProps.ToolTipKey="CatWin.SearchTooltip"
                             ToolTip="Search by code or name — press Enter" KeyDown="TxtSearch_KeyDown"/>
                    <TextBlock x:Name="IcoSearch" Text="🔍" FontSize="12" VerticalAlignment="Center"
                               HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" Opacity="0.55"
                               FlowDirection="LeftToRight"/>
                </Grid>

                <Button x:Name="BtnRefresh" Grid.Column="4" Content="Refresh" loc:LocProps.Key="CatWin.Refresh"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0" Click="Refresh_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10,8,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.15*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D0D5DA" BorderThickness="1" CornerRadius="2" Padding="12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="LblCode" Text="Item Code" loc:LocProps.Key="CatWin.ItemCode" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtCode" Style="{StaticResource FieldBoxLtr}" MaxLength="40"/>

                        <TextBlock x:Name="LblName" Text="Item Name" loc:LocProps.Key="CatWin.ItemName" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtName" Style="{StaticResource FieldBox}" MaxLength="120" TextChanged="TxtName_TextChanged"/>

                        <TextBlock x:Name="LblNameEn" Text="Latin Name" loc:LocProps.Key="CatWin.NameLatin" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtNameEn" Style="{StaticResource FieldBoxLtr}" MaxLength="120"/>

                        <TextBlock x:Name="LblWarehouse" Text="Warehouse" loc:LocProps.Key="CatWin.Warehouse" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbWarehouse" Style="{StaticResource FieldCombo}"
                                  DisplayMemberPath="Display" SelectedValuePath="Code" IsEditable="False"/>

                        <TextBlock x:Name="LblSpecs" Text="General Specifications" loc:LocProps.Key="CatWin.GeneralSpecs" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtSpecs" Style="{StaticResource FieldBox}" Height="56" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="2000"/>

                        <TextBlock x:Name="LblImage" Text="Item Image" loc:LocProps.Key="CatWin.Image" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="72" Height="72" BorderBrush="#C0C4C8" BorderThickness="1"
                                    Background="#FAFBFC" CornerRadius="2" Margin="0,0,8,0">
                                <Image x:Name="ImgPreview" Stretch="Uniform" Margin="2"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="BtnPickImage" Content="Choose Image…" loc:LocProps.Key="CatWin.PickImage"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,4" HorizontalAlignment="Stretch" Click="PickImage_Click"/>
                                <Button x:Name="BtnClearImage" Content="Remove Image" loc:LocProps.Key="CatWin.ClearImage"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0" HorizontalAlignment="Stretch" Click="ClearImage_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TxtMode" Margin="0,6,0,0" FontSize="11" Foreground="#667788" Text="• Ready"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D0D5DA" BorderThickness="1" CornerRadius="2" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F0F3F6" BorderBrush="#D0D5DA" BorderThickness="0,0,0,1" Padding="8,4">
                        <TextBlock x:Name="LblTree" Text="Category Tree" loc:LocProps.Key="CatWin.TreeTitle"
                                   FontWeight="SemiBold" FontSize="11" Foreground="#334455"/>
                    </Border>
                    <TreeView x:Name="TreeGroups" BorderThickness="0" Padding="4,2" Background="Transparent" FontSize="11"
                              SelectedItemChanged="TreeGroups_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Padding" Value="1,1"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#ECEFF2" BorderBrush="#D0D5DA" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" FontSize="11" Foreground="#445566" Text=""/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnNew" Content="New" loc:LocProps.Key="Buttons.New" Style="{StaticResource SecondaryButtonStyle}" Click="New_Click"/>
                    <Button x:Name="BtnSave" Content="Save" loc:LocProps.Key="Buttons.Save" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
                    <Button x:Name="BtnDelete" Content="Delete" loc:LocProps.Key="Buttons.Delete" Style="{StaticResource SecondaryButtonStyle}" Click="Delete_Click"/>
                    <Button x:Name="BtnEdit" Content="Edit" loc:LocProps.Key="Buttons.Edit" Style="{StaticResource SecondaryButtonStyle}" Click="Edit_Click"/>
                    <Button x:Name="BtnClose" Content="Close" loc:LocProps.Key="Buttons.Close" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:BaseWin>
