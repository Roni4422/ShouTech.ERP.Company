<Window x:Class="ShouTech.App.Views.BinWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recycle Bin"
        Height="520"
        Width="780"
        MinHeight="360"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Tahoma"
        FontSize="13"
        Background="{DynamicResource ShellUnifiedLightBrush}"
        Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="Recycle Bin"
                   Margin="0,0,0,4"/>

        <TextBlock x:Name="HintText"
                   Grid.Row="1"
                   TextWrapping="Wrap"
                   Opacity="0.82"
                   Margin="0,0,0,10"
                   Text="Soft-deleted master data for the active company. Restore returns items to working lists. Permanent delete cannot be undone."/>

        <DataGrid x:Name="ItemsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#0A000000"
                  BorderBrush="{DynamicResource ShellContentBorderBrush}"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dataset" Binding="{Binding DatasetKey}" Width="120"/>
                <DataGridTextColumn Header="Label" Binding="{Binding DisplayLabel}" Width="*"/>
                <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="130"/>
                <DataGridTextColumn Header="Deleted at" Binding="{Binding DeletedAt}" Width="150"/>
                <DataGridTextColumn Header="Deleted by" Binding="{Binding DeletedBy}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,10,0,10"
                   Opacity="0.88"
                   TextWrapping="Wrap"/>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="Refresh" Width="96" Height="30" Margin="0,0,8,0" Click="Refresh_Click"/>
                <Button x:Name="RestoreButton" Content="Restore selected" Width="132" Height="30" Margin="0,0,8,0" Click="Restore_Click"/>
                <Button x:Name="PurgeButton" Content="Delete permanently" Width="140" Height="30" Margin="0,0,8,0" Click="Purge_Click"/>
                <Button x:Name="CloseButton" Content="Close" Width="96" Height="30" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
