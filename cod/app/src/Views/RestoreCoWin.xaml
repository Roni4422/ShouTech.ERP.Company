<Window x:Class="ShouTech.App.Views.RestoreCoWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore company"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="320" MinWidth="420"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Tahoma">
    <Border Margin="12" Padding="12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="txtTitle" Text="Restore deleted company"
                           FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="txtHint"
                           Text="Select a logically deleted company, then click Restore."
                           FontSize="12" Opacity="0.75" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <ListBox x:Name="lstDeleted"
                     Grid.Row="1"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     DisplayMemberPath="DisplayName"/>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnRefresh" Grid.Column="0"
                        Content="Refresh" Width="90" Height="32"
                        HorizontalAlignment="Left"
                        Click="BtnRefresh_Click"
                        Style="{DynamicResource SecondaryButtonStyle}"/>
                <Button x:Name="btnRestore" Grid.Column="1"
                        Content="Restore" Width="100" Height="32"
                        Click="BtnRestore_Click"
                        Style="{DynamicResource PrimaryButtonStyle}"/>
                <Button x:Name="btnClose" Grid.Column="3"
                        Content="Close" Width="90" Height="32"
                        IsCancel="True"
                        Click="BtnClose_Click"
                        Style="{DynamicResource SecondaryButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
