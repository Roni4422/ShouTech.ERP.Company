<local:BaseWin x:Class="ShouTech.App.Views.MatCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShouTech.App.Views"
        xmlns:loc="clr-namespace:ShouTech.App.Localization"
        xmlns:interaction="clr-namespace:ShouTech.App.Interaction"
        loc:LocProps.WindowKey="Inventory.MaterialCard"
        Title="Material Card"
        Width="920"
        Height="620"
        MinWidth="840"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource ApplicationFontFamily}"
        FontSize="12"
        NumberSubstitution.CultureSource="Override"
        NumberSubstitution.CultureOverride="en-US"
        NumberSubstitution.Substitution="European"
        Language="en-US"
        ResizeMode="CanResizeWithGrip">

    <!--
        FlowDirection is applied centrally from MatCard.xaml.cs
        through ApplyDirection().
        Arabic  = RightToLeft
        English = LeftToRight
    -->

    <Window.Resources>

        <!-- =========================================================
             FIELD STYLES
             ========================================================= -->

        <Style x:Key="FieldBox"
               TargetType="TextBox"
               BasedOn="{StaticResource AppTextBoxStyle}">

            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>


        <!--
            Codes / numbers remain LTR even when the application is Arabic.
        -->
        <Style x:Key="CodeBox"
               TargetType="TextBox"
               BasedOn="{StaticResource FieldBox}">

            <Setter Property="FlowDirection"
                    Value="LeftToRight"/>

            <Setter Property="Language" Value="en-US"/>
            <Setter Property="NumberSubstitution.CultureSource" Value="Override"/>
            <Setter Property="NumberSubstitution.CultureOverride" Value="en-US"/>
            <Setter Property="NumberSubstitution.Substitution" Value="European"/>

            <Setter Property="TextAlignment"
                    Value="Left"/>
        </Style>


        <Style x:Key="FieldCombo"
               TargetType="ComboBox"
               BasedOn="{StaticResource AppComboBoxStyle}">

            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Margin" Value="0,2,0,2"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding" Value="8,0"/>
        </Style>


        <!-- =========================================================
             LABEL
             ========================================================= -->

        <Style x:Key="Lbl"
               TargetType="TextBlock">

            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Margin"
                    Value="0,0,5,0"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimary}"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
        </Style>


        <!-- =========================================================
             SIDEBAR BUTTON
             ========================================================= -->

        <Style x:Key="SecBtn"
               TargetType="Button">

            <Setter Property="Height" Value="29"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="Margin"
                    Value="3,1,3,1"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderBrush"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimary}"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource AccentHover}"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="SecBtnOn"
               TargetType="Button"
               BasedOn="{StaticResource SecBtn}">

            <Setter Property="Background"
                    Value="{DynamicResource AccentHover}"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AccentDark}"/>
        </Style>


        <!-- =========================================================
             FOOTER BUTTON
             ========================================================= -->

        <Style x:Key="FootBtn"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">

            <Setter Property="MinWidth"
                    Value="72"/>

            <Setter Property="Height"
                    Value="29"/>

            <Setter Property="Margin"
                    Value="3,0,0,0"/>

            <Setter Property="Padding"
                    Value="9,2"/>

        </Style>


        <!-- =========================================================
             SECTION HEADER
             ========================================================= -->

        <Style x:Key="SideHeader"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{DynamicResource AccentPrimary}"/>

            <Setter Property="Padding"
                    Value="8,5"/>

            <Setter Property="CornerRadius"
                    Value="0"/>
        </Style>


        <!-- =========================================================
             DATAGRID
             ========================================================= -->

        <Style x:Key="UnitNumberTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>

        <Style x:Key="UnitIndexTextStyle" TargetType="TextBlock" BasedOn="{StaticResource UnitNumberTextStyle}">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="UnitNumberEditStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="UnitTextCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="UnitTextEditStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <SolidColorBrush x:Key="UnitGridHeaderBrush" Color="#556F7A"/>
        <SolidColorBrush x:Key="UnitGridHeaderBorderBrush" Color="#78909C"/>
        <SolidColorBrush x:Key="UnitGridSurfaceBrush" Color="#FAFBFC"/>
        <SolidColorBrush x:Key="UnitGridAlternateBrush" Color="#F1F5F7"/>
        <SolidColorBrush x:Key="UnitGridHoverBrush" Color="#E7EEF1"/>
        <SolidColorBrush x:Key="UnitGridSelectedBrush" Color="#26F39A16"/>
        <SolidColorBrush x:Key="UnitGridSelectedBorderBrush" Color="#F39A16"/>
        <SolidColorBrush x:Key="UnitGridActiveCellBrush" Color="#FFFDFC"/>

        <Style x:Key="UnitGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Background" Value="{StaticResource UnitGridSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UnitGridHeaderBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource UnitGridSurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource UnitGridAlternateBrush}"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>

        <Style x:Key="UnitGridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource VisuDataGridHeaderStyle}">
            <Setter Property="Background" Value="{StaticResource UnitGridHeaderBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource UnitGridHeaderBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="UnitGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource VisuDataGridRowStyle}">
            <Setter Property="Background" Value="{StaticResource UnitGridSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource UnitGridAlternateBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource UnitGridHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource UnitGridSelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource UnitGridSelectedBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UnitGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource VisuDataGridCellStyle}">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="{StaticResource UnitGridSelectedBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="{StaticResource UnitGridSelectedBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>




        <!-- =========================================================
             CHECKBOX
             ========================================================= -->

        <Style TargetType="CheckBox">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimary}"/>

        </Style>

    </Window.Resources>


    <!-- =============================================================
         ROOT
         ============================================================= -->

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- =========================================================
             BODY
             ========================================================= -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="148"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- =====================================================
                 SIDEBAR
                 ===================================================== -->

            <Border Grid.Column="0"
                    Background="{DynamicResource SideBackground}"
                    BorderBrush="{DynamicResource FieldBorder}"
                    BorderThickness="0,0,1,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- Sections -->

                    <Border Grid.Row="0"
                            Style="{StaticResource SideHeader}">

                        <TextBlock Text="Material Sections"
                                   loc:LocProps.Key="MatCard.Sections"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="White"/>

                    </Border>


                    <StackPanel Grid.Row="1"
                                Margin="0,2,0,0">

                        <Button x:Name="NavDesc"
                                Content="Material Description"
                                loc:LocProps.Key="MatCard.TabGeneral"
                                Style="{StaticResource SecBtnOn}"
                                Tag="0"
                                Click="NavSection_Click"/>

                        <Button x:Name="NavUnits"
                                Content="Units &amp; Prices"
                                loc:LocProps.Key="MatCard.TabUnits"
                                Style="{StaticResource SecBtn}"
                                Tag="1"
                                Click="NavSection_Click"/>

                        <Button x:Name="NavStock"
                                Content="Stock"
                                loc:LocProps.Key="MatCard.TabStock"
                                Style="{StaticResource SecBtn}"
                                Tag="2"
                                Click="NavSection_Click"/>

                        <Button x:Name="NavAccounts"
                                Content="Accounts"
                                loc:LocProps.Key="MatCard.TabAccounts"
                                Style="{StaticResource SecBtn}"
                                Tag="3"
                                Click="NavSection_Click"/>

                        <Button x:Name="NavExtra"
                                Content="Specifications &amp; Images"
                                loc:LocProps.Key="MatCard.TabExtra"
                                Style="{StaticResource SecBtn}"
                                Tag="4"
                                Click="NavSection_Click"/>

                    </StackPanel>


                    <!-- Quick navigation -->

                    <Border Grid.Row="2"
                            Style="{StaticResource SideHeader}"
                            Margin="0,7,0,0">

                        <TextBlock Text="Quick Navigation"
                                   loc:LocProps.Key="MatCard.GoTo"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="White"/>

                    </Border>


                    <Grid Grid.Row="3"
                          Margin="6,5,6,3">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtGoto"
                                 Grid.Column="0"
                                 Style="{StaticResource FieldBox}"
                                 KeyDown="TxtGoto_KeyDown"/>

                        <Button Grid.Column="1"
                                Content="🔎"
                                Width="28"
                                Height="23"
                                Click="Goto_Click"
                                Margin="4,0,0,0"
                                Background="{DynamicResource FieldBackgroundBrush}"
                                BorderBrush="{DynamicResource FieldBorder}"
                                BorderThickness="1"
                                Cursor="Hand"
                                ToolTip="Search"
                                loc:LocProps.ToolTipKey="MatCard.Search"/>

                    </Grid>


                    <!-- Meta -->

                    <TextBlock Grid.Row="4"
                               x:Name="TxtMeta"
                               FontSize="10"
                               Margin="6,3,6,3"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"/>


                    <!-- Image path -->

                    <Grid Grid.Row="5"
                          Margin="6,0,6,4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtImagePath"
                                 Grid.Column="0"
                                 Style="{StaticResource CodeBox}"
                                 FontSize="10"/>

                        <Button Grid.Column="1"
                                Content="..."
                                Width="28"
                                Height="23"
                                Click="BrowseImage_Click"
                                Margin="4,0,0,0"
                                Background="{DynamicResource FieldBackgroundBrush}"
                                BorderBrush="{DynamicResource FieldBorder}"
                                BorderThickness="1"
                                Cursor="Hand"/>

                    </Grid>


                    <!-- Image preview -->

                    <Border Grid.Row="6"
                            BorderBrush="{DynamicResource FieldBorder}"
                            BorderThickness="1"
                            Background="{DynamicResource FieldBackgroundBrush}"
                            Margin="6,3,6,5"
                            MinHeight="105"
                            Height="118">

                        <Grid>

                            <TextBlock Text="No image"
                                       loc:LocProps.Key="MatCard.NoImage"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       FontSize="11"/>

                            <Image x:Name="ImgPreview"
                                   Stretch="Uniform"
                                   Margin="4"/>

                        </Grid>

                    </Border>


                    <!-- Image -->

                    <Border Grid.Row="7"
                            Style="{StaticResource SideHeader}">

                        <TextBlock Text="Image"
                                   loc:LocProps.Key="MatCard.Image"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="White"/>

                    </Border>


                    <!-- Color -->

                    <Border Grid.Row="8"
                            Style="{StaticResource SideHeader}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Color"
                                       loc:LocProps.Key="MatCard.Color"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>

                            <ComboBox x:Name="CmbColor"
                                      Grid.Column="1"
                                      Style="{StaticResource FieldCombo}"
                                      Height="22"
                                      Margin="0"
                                      SelectionChanged="Color_SelectionChanged"
                                      HorizontalContentAlignment="Stretch"/>

                        </Grid>

                    </Border>

                </Grid>

            </Border>


            <!-- =====================================================
                 CONTENT
                 ===================================================== -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- =================================================
                     TITLE
                     ================================================= -->

                <Border Grid.Row="0"
                        Background="{DynamicResource AccentLight}"
                        BorderBrush="{DynamicResource FieldBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">

                    <TextBlock Text="Material Card"
                               loc:LocProps.Key="Inventory.MaterialCard"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentDark}"/>

                </Border>


                <!-- =================================================
                     MATERIAL HEADER
                     ================================================= -->

                <Border Grid.Row="1"
                        Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource FieldBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="11,9">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <!-- Fields -->

                        <Grid Grid.Column="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <!-- Code -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Code"
                                       loc:LocProps.Key="MatCard.Code"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtCode"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Style="{StaticResource CodeBox}"
                                     Margin="0,3,12,3"/>


                            <!-- Item number -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Text="Item #"
                                       loc:LocProps.Key="MatCard.ItemNo"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtItemNo"
                                     Grid.Row="0"
                                     Grid.Column="3"
                                     Style="{StaticResource CodeBox}"
                                     IsReadOnly="True"
                                     Background="{DynamicResource PanelBackground}"
                                     Margin="0,3,12,3"/>


                            <!-- Inactive -->

                            <CheckBox x:Name="ChkInactive"
                                      Grid.Row="0"
                                      Grid.Column="4"
                                      Content="Inactive"
                                      loc:LocProps.Key="MatCard.Inactive"
                                      VerticalAlignment="Center"
                                      Margin="6,0,0,0"/>


                            <!-- Group -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Group"
                                       loc:LocProps.Key="MatCard.Group"
                                       Style="{StaticResource Lbl}"/>

                            <ComboBox x:Name="CmbGroup"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      Style="{StaticResource FieldCombo}"
                                      IsEditable="True"
                                      Margin="0,3,12,3"/>


                            <!-- Type -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="Type"
                                       loc:LocProps.Key="MatCard.Type"
                                       Style="{StaticResource Lbl}"/>

                            <ComboBox x:Name="CmbItemType"
                                      Grid.Row="1"
                                      Grid.Column="3"
                                      Grid.ColumnSpan="2"
                                      Style="{StaticResource FieldCombo}"
                                      Margin="0,3,0,3"/>


                            <!-- Name -->

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Name"
                                       loc:LocProps.Key="MatCard.Name"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtName"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="4"
                                     Style="{StaticResource FieldBox}"
                                     FontWeight="SemiBold"
                                     Margin="0,3,0,3"/>


                            <!-- Latin name -->

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Latin Name"
                                       loc:LocProps.Key="MatCard.LatinName"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtNameEn"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="4"
                                     Style="{StaticResource CodeBox}"
                                     FlowDirection="LeftToRight"
                                     TextAlignment="Left"
                                     Language="en-US"
                                     VerticalContentAlignment="Center"
                                     Margin="0,3,0,3"/>

                        </Grid>


                        <!-- Record navigation -->

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="9,1,0,0">

                            <Button x:Name="BtnNavFirst"
                                    Content="|◀"
                                    Width="28"
                                    Height="23"
                                    Margin="1"
                                    Click="NavFirst_Click"
                                    Cursor="Hand"
                                    Style="{StaticResource FootBtn}"
                                    MinWidth="28"/>

                            <Button x:Name="BtnNavPrev"
                                    Content="◀"
                                    Width="28"
                                    Height="23"
                                    Margin="1"
                                    Click="NavPrev_Click"
                                    Cursor="Hand"
                                    Style="{StaticResource FootBtn}"
                                    MinWidth="28"/>

                            <TextBlock x:Name="TxtNavPos"
                                       MinWidth="44"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="4,0"
                                       FlowDirection="LeftToRight"/>

                            <Button x:Name="BtnNavNext"
                                    Content="▶"
                                    Width="28"
                                    Height="23"
                                    Margin="1"
                                    Click="NavNext_Click"
                                    Cursor="Hand"
                                    Style="{StaticResource FootBtn}"
                                    MinWidth="28"/>

                            <Button x:Name="BtnNavLast"
                                    Content="▶|"
                                    Width="28"
                                    Height="23"
                                    Margin="1"
                                    Click="NavLast_Click"
                                    Cursor="Hand"
                                    Style="{StaticResource FootBtn}"
                                    MinWidth="28"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- =================================================
                     PANELS
                     ================================================= -->

                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBackground}"
                        Padding="8,6">

                    <Grid>


                        <!-- =================================================
                             PANEL 0 — DESCRIPTION
                             ================================================= -->

                        <Grid x:Name="PanelDesc">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="4"
                                       Text="Material Description"
                                       loc:LocProps.Key="MatCard.DescHeader"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="0,0,0,6"
                                       Foreground="{DynamicResource AccentDark}"/>


                            <!-- Category / Brand -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Category"
                                       loc:LocProps.Key="MatCard.Category"
                                       Style="{StaticResource Lbl}"/>

                            <ComboBox x:Name="CmbCategory"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      Style="{StaticResource FieldCombo}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Key"
                                      IsEditable="False"
                                      IsTextSearchEnabled="True"
                                      MaxDropDownHeight="260"
                                      Margin="0,2,12,2"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="Brand"
                                       loc:LocProps.Key="MatCard.Brand"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtBrand"
                                     Grid.Row="1"
                                     Grid.Column="3"
                                     Style="{StaticResource FieldBox}"
                                     Margin="0,2,0,2"/>


                            <!-- Model / Size -->

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Model"
                                       loc:LocProps.Key="MatCard.Model"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtModel"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Style="{StaticResource FieldBox}"
                                     Margin="0,2,12,2"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="Size / Spec"
                                       loc:LocProps.Key="MatCard.SizeSpec"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtSizeSpec"
                                     Grid.Row="2"
                                     Grid.Column="3"
                                     Style="{StaticResource FieldBox}"
                                     Margin="0,2,0,2"/>


                            <!-- Manufacturer / Origin -->

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Manufacturer"
                                       loc:LocProps.Key="MatCard.Manufacturer"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtManufacturer"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Style="{StaticResource FieldBox}"
                                     Margin="0,2,12,2"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="2"
                                       Text="Origin"
                                       loc:LocProps.Key="MatCard.Origin"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtOriginCountry"
                                     Grid.Row="3"
                                     Grid.Column="3"
                                     Style="{StaticResource FieldBox}"
                                     Margin="0,2,0,2"/>


                            <!-- Source / Alternate code -->

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="Source"
                                       loc:LocProps.Key="MatCard.Source"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtSource"
                                     Grid.Row="4"
                                     Grid.Column="1"
                                     Style="{StaticResource FieldBox}"
                                     Margin="0,2,12,2"/>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="2"
                                       Text="Alternate Code"
                                       loc:LocProps.Key="MatCard.AltCode"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtAltCode"
                                     Grid.Row="4"
                                     Grid.Column="3"
                                     Style="{StaticResource CodeBox}"
                                     Margin="0,2,0,2"/>


                            <!-- GTIN / Supplier -->

                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Text="GTIN"
                                       loc:LocProps.Key="MatCard.Gtin"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtGtin"
                                     Grid.Row="5"
                                     Grid.Column="1"
                                     Style="{StaticResource CodeBox}"
                                     Margin="0,2,12,2"/>

                            <TextBlock Grid.Row="5"
                                       Grid.Column="2"
                                       Text="Supplier Code"
                                       loc:LocProps.Key="MatCard.SupplierCode"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtSupplierCode"
                                     Grid.Row="5"
                                     Grid.Column="3"
                                     Style="{StaticResource CodeBox}"
                                     Margin="0,2,0,2"/>


                            <!-- ABC / Status -->

                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Text="ABC Class"
                                       loc:LocProps.Key="MatCard.Abc"
                                       Style="{StaticResource Lbl}"/>

                            <ComboBox x:Name="CmbAbcClass"
                                      Grid.Row="6"
                                      Grid.Column="1"
                                      Style="{StaticResource FieldCombo}"
                                      Margin="0,2,12,2"/>

                            <TextBlock Grid.Row="6"
                                       Grid.Column="2"
                                       Text="Status"
                                       loc:LocProps.Key="MatCard.StatusLabel"
                                       Style="{StaticResource Lbl}"/>

                            <ComboBox x:Name="CmbStatus"
                                      Grid.Row="6"
                                      Grid.Column="3"
                                      Style="{StaticResource FieldCombo}"
                                      Margin="0,2,0,2"/>


                            <!-- Flags -->

                            <StackPanel Grid.Row="7"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="4"
                                        Orientation="Horizontal"
                                        Margin="0,5,0,3">

                                <CheckBox x:Name="ChkIsStocked"
                                          Content="Stocked"
                                          loc:LocProps.Key="MatCard.Stocked"
                                          Margin="0,0,12,0"
                                          IsChecked="True"/>

                                <CheckBox x:Name="ChkIsPurchased"
                                          Content="Purchased"
                                          loc:LocProps.Key="MatCard.Purchased"
                                          Margin="0,0,12,0"
                                          IsChecked="True"/>

                                <CheckBox x:Name="ChkIsSold"
                                          Content="Sold"
                                          loc:LocProps.Key="MatCard.Sold"
                                          Margin="0,0,12,0"
                                          IsChecked="True"/>

                                <CheckBox x:Name="ChkIsProduced"
                                          Content="Produced"
                                          loc:LocProps.Key="MatCard.Produced"
                                          Margin="0,0,12,0"/>

                                <CheckBox x:Name="ChkIsService"
                                          Content="Service"
                                          loc:LocProps.Key="MatCard.Service"/>

                            </StackPanel>


                            <!-- Notes -->

                            <TextBlock Grid.Row="8"
                                       Grid.Column="0"
                                       Text="Notes"
                                       loc:LocProps.Key="MatCard.Notes"
                                       Style="{StaticResource Lbl}"
                                       VerticalAlignment="Top"/>

                            <TextBox x:Name="TxtNotes"
                                     Grid.Row="8"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="50"
                                     Margin="0,2,0,2"
                                     Background="{DynamicResource FieldBackgroundBrush}"
                                     BorderBrush="{DynamicResource FieldBorder}"
                                     BorderThickness="1"
                                     Padding="5"/>

                        </Grid>


                        <!-- =================================================
                             PANEL 1 — UNITS & PRICES
                             ================================================= -->

                        <Grid x:Name="PanelUnits"
                              Visibility="Collapsed">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0"
                                       Text="Units &amp; Prices"
                                       loc:LocProps.Key="MatCard.UnitsHeader"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="0,0,0,6"
                                       Foreground="{DynamicResource AccentDark}"/>


                            <Grid Grid.Row="1"
                                  Margin="0,0,0,6">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <!-- Min -->

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Min"
                                           loc:LocProps.Key="MatCard.MinQty"
                                           Style="{StaticResource Lbl}"/>

                                <TextBox x:Name="TxtMinQty"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Style="{StaticResource CodeBox}"
                                         Margin="0,0,7,0"/>


                                <!-- Max -->

                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Max"
                                           loc:LocProps.Key="MatCard.MaxQty"
                                           Style="{StaticResource Lbl}"/>

                                <TextBox x:Name="TxtMaxQty"
                                         Grid.Row="0"
                                         Grid.Column="3"
                                         Style="{StaticResource CodeBox}"
                                         Margin="0,0,7,0"/>


                                <!-- Currency -->

                                <TextBlock Grid.Row="0"
                                           Grid.Column="4"
                                           Text="Currency"
                                           loc:LocProps.Key="MatCard.Currency"
                                           Style="{StaticResource Lbl}"/>

                                <ComboBox x:Name="CmbPriceCurrency"
                                          Grid.Row="0"
                                          Grid.Column="5"
                                          Style="{StaticResource FieldCombo}"/>


                                <!-- Cost -->

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Cost"
                                           loc:LocProps.Key="MatCard.Cost"
                                           Style="{StaticResource Lbl}"/>

                                <TextBox x:Name="TxtCost"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Style="{StaticResource CodeBox}"
                                         Margin="0,0,7,0"/>


                                <!-- Method -->

                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="Method"
                                           loc:LocProps.Key="MatCard.Method"
                                           Style="{StaticResource Lbl}"/>

                                <ComboBox x:Name="CmbCostMethod"
                                          Grid.Row="1"
                                          Grid.Column="3"
                                          Style="{StaticResource FieldCombo}"
                                          Margin="0,0,7,0"/>


                                <!-- Tax -->

                                <TextBlock Grid.Row="1"
                                           Grid.Column="4"
                                           Text="Tax %"
                                           loc:LocProps.Key="MatCard.TaxRate"
                                           Style="{StaticResource Lbl}"/>

                                <TextBox x:Name="TxtTaxRate"
                                         Grid.Row="1"
                                         Grid.Column="5"
                                         Style="{StaticResource CodeBox}"/>


                                <!-- Unit flags -->

                                <StackPanel Grid.Row="2"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="7"
                                            Orientation="Horizontal"
                                            Margin="0,4,0,0">

                                    <CheckBox x:Name="ChkHasSerial"
                                              Content="Serial"
                                              loc:LocProps.Key="MatCard.HasSerial"
                                              Margin="0,0,9,0"/>

                                    <CheckBox x:Name="ChkHasExpiry"
                                              Content="Expiry"
                                              loc:LocProps.Key="MatCard.HasExpiry"
                                              Margin="0,0,9,0"/>

                                    <CheckBox x:Name="ChkHasBatch"
                                              Content="Batch"
                                              loc:LocProps.Key="MatCard.HasBatch"
                                              Margin="0,0,9,0"/>

                                    <CheckBox x:Name="ChkIsTaxable"
                                              Content="Taxable"
                                              loc:LocProps.Key="MatCard.Taxable"
                                              Margin="0,0,9,0"/>

                                    <CheckBox x:Name="ChkPriceIncludesTax"
                                              Content="Price Includes Tax"
                                              loc:LocProps.Key="MatCard.PriceIncludesTax"
                                              Margin="0,0,9,0"/>

                                    <TextBlock Text="Shelf Life"
                                               loc:LocProps.Key="MatCard.ShelfDays"
                                               Style="{StaticResource Lbl}"
                                               Margin="7,0,4,0"/>

                                    <TextBox x:Name="TxtShelfLifeDays"
                                             Width="50"
                                             Style="{StaticResource CodeBox}"/>

                                </StackPanel>

                            </Grid>


                            <Border Grid.Row="2"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    Padding="6,4">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Units and prices"
                                               loc:LocProps.Key="MatCard.UnitsHeader"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="11"
                                               DockPanel.Dock="Left"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button x:Name="BtnUnitAdd"
                                                Content="+"
                                                Width="32"
                                                Height="28"
                                                Margin="0,0,4,0"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Add unit row"
                                                loc:LocProps.ToolTipKey="Buttons.Add"
                                                Click="AddUnit_Click"/>
                                        <Button x:Name="BtnUnitRemove"
                                                Content="−"
                                                Width="32"
                                                Height="28"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Remove selected unit row"
                                                loc:LocProps.ToolTipKey="Buttons.Delete"
                                                Click="RemoveUnit_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Units table -->

                            <DataGrid x:Name="DgUnits"
                                      interaction:DataGridTableBehavior.EnableStandardContextMenu="True"
                                      Grid.Row="3"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      EnableRowVirtualization="True"
                                      HeadersVisibility="Column"
                                      SelectionUnit="FullRow"
                                      SelectionMode="Extended"
                                      Style="{StaticResource UnitGridStyle}"
                                      RowStyle="{StaticResource UnitGridRowStyle}"
                                      ColumnHeaderStyle="{StaticResource UnitGridHeaderStyle}"
                                      CellStyle="{StaticResource UnitGridCellStyle}"
                                      RowHeight="34"
                                      ColumnHeaderHeight="38"
                                      Language="en-US"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Width="36"
                                        IsReadOnly="True"
                                        Binding="{Binding LineNo}"
                                        ElementStyle="{StaticResource UnitIndexTextStyle}">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="#"
                                                       loc:LocProps.Key="MatCard.GridNumber"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Binding="{Binding UnitName, UpdateSourceTrigger=LostFocus}"
                                        Width="130"
                                        ElementStyle="{StaticResource UnitTextCellStyle}"
                                        EditingElementStyle="{StaticResource UnitTextEditStyle}">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Unit"
                                                       loc:LocProps.Key="MatCard.GridUnit"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Binding="{Binding Factor, UpdateSourceTrigger=LostFocus, ConverterCulture=en-US}"
                                        Width="85"
                                        ElementStyle="{StaticResource UnitNumberTextStyle}"
                                        EditingElementStyle="{StaticResource UnitNumberEditStyle}">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Factor"
                                                       loc:LocProps.Key="MatCard.GridFactor"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Binding="{Binding PriceSale, UpdateSourceTrigger=LostFocus, ConverterCulture=en-US}"
                                        Width="95"
                                        ElementStyle="{StaticResource UnitNumberTextStyle}"
                                        EditingElementStyle="{StaticResource UnitNumberEditStyle}">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Sale"
                                                       loc:LocProps.Key="MatCard.GridSale"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Binding="{Binding PricePurchase, UpdateSourceTrigger=LostFocus, ConverterCulture=en-US}"
                                        Width="100"
                                        ElementStyle="{StaticResource UnitNumberTextStyle}"
                                        EditingElementStyle="{StaticResource UnitNumberEditStyle}">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Purchase"
                                                       loc:LocProps.Key="MatCard.GridPurchase"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Binding="{Binding PriceWholesale, UpdateSourceTrigger=LostFocus, ConverterCulture=en-US}"
                                        Width="105"
                                        ElementStyle="{StaticResource UnitNumberTextStyle}"
                                        EditingElementStyle="{StaticResource UnitNumberEditStyle}">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Wholesale"
                                                       loc:LocProps.Key="MatCard.GridWholesale"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Binding="{Binding PriceRetail, UpdateSourceTrigger=LostFocus, ConverterCulture=en-US}"
                                        Width="95"
                                        ElementStyle="{StaticResource UnitNumberTextStyle}"
                                        EditingElementStyle="{StaticResource UnitNumberEditStyle}">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Retail"
                                                       loc:LocProps.Key="MatCard.GridRetail"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Binding="{Binding PriceSpecial, UpdateSourceTrigger=LostFocus, ConverterCulture=en-US}"
                                        Width="95"
                                        ElementStyle="{StaticResource UnitNumberTextStyle}"
                                        EditingElementStyle="{StaticResource UnitNumberEditStyle}">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Special"
                                                       loc:LocProps.Key="MatCard.GridSpecial"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Binding="{Binding PriceExport, UpdateSourceTrigger=LostFocus, ConverterCulture=en-US}"
                                        Width="95"
                                        ElementStyle="{StaticResource UnitNumberTextStyle}"
                                        EditingElementStyle="{StaticResource UnitNumberEditStyle}">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Export"
                                                       loc:LocProps.Key="MatCard.GridExport"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Binding="{Binding PriceDistributor, UpdateSourceTrigger=LostFocus, ConverterCulture=en-US}"
                                        Width="110"
                                        ElementStyle="{StaticResource UnitNumberTextStyle}"
                                        EditingElementStyle="{StaticResource UnitNumberEditStyle}">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Distributor"
                                                       loc:LocProps.Key="MatCard.GridDistributor"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Binding="{Binding Barcode, UpdateSourceTrigger=LostFocus}"
                                        Width="160"
                                        ElementStyle="{StaticResource UnitTextCellStyle}"
                                        EditingElementStyle="{StaticResource UnitTextEditStyle}">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Barcode"
                                                       loc:LocProps.Key="MatCard.GridBarcode"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>


                        <!-- =================================================
                             PANEL 2 — STOCK
                             ================================================= -->

                        <Grid x:Name="PanelStock"
                              Visibility="Collapsed">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="4"
                                       Text="Stock"
                                       loc:LocProps.Key="MatCard.StockHeader"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="0,0,0,6"
                                       Foreground="{DynamicResource AccentDark}"/>


                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="On Hand"
                                       loc:LocProps.Key="MatCard.QtyOnHand"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtQtyOnHand"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Style="{StaticResource CodeBox}"
                                     Margin="0,0,12,0"/>


                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="Reorder Qty"
                                       loc:LocProps.Key="MatCard.ReorderQty"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtReorderQty"
                                     Grid.Row="1"
                                     Grid.Column="3"
                                     Style="{StaticResource CodeBox}"/>


                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Safety Stock"
                                       loc:LocProps.Key="MatCard.SafetyStock"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtSafetyStock"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Style="{StaticResource CodeBox}"
                                     Margin="0,0,12,0"/>


                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="Default Warehouse"
                                       loc:LocProps.Key="MatCard.DefaultWarehouse"
                                       Style="{StaticResource Lbl}"/>

                            <ComboBox x:Name="CmbDefaultWarehouse"
                                      Grid.Row="2"
                                      Grid.Column="3"
                                      Style="{StaticResource FieldCombo}"
                                      IsEditable="True"/>


                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Shelf / Bin"
                                       loc:LocProps.Key="MatCard.ShelfBin"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtShelfBin"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Style="{StaticResource CodeBox}"
                                     Margin="0,0,12,0"/>


                            <TextBlock Grid.Row="3"
                                       Grid.Column="2"
                                       Text="Lead Time"
                                       loc:LocProps.Key="MatCard.LeadTime"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtLeadTimeDays"
                                     Grid.Row="3"
                                     Grid.Column="3"
                                     Style="{StaticResource CodeBox}"/>


                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="Net Weight"
                                       loc:LocProps.Key="MatCard.WeightNet"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtWeightNet"
                                     Grid.Row="4"
                                     Grid.Column="1"
                                     Style="{StaticResource CodeBox}"
                                     Margin="0,0,12,0"/>


                            <TextBlock Grid.Row="4"
                                       Grid.Column="2"
                                       Text="Gross Weight"
                                       loc:LocProps.Key="MatCard.WeightGross"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtWeightGross"
                                     Grid.Row="4"
                                     Grid.Column="3"
                                     Style="{StaticResource CodeBox}"/>


                            <StackPanel Grid.Row="5"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="4"
                                        Orientation="Horizontal"
                                        Margin="0,9,0,0">

                                <CheckBox x:Name="ChkAllowNegative"
                                          Content="Allow Negative"
                                          loc:LocProps.Key="MatCard.AllowNegative"
                                          Margin="0,0,14,0"/>

                                <CheckBox x:Name="ChkTrackLocation"
                                          Content="Track Location"
                                          loc:LocProps.Key="MatCard.TrackLocation"
                                          Margin="0,0,14,0"/>

                                <CheckBox x:Name="ChkQualityCheck"
                                          Content="Quality Check"
                                          loc:LocProps.Key="MatCard.QualityCheck"/>

                            </StackPanel>


                            <TextBlock x:Name="TxtStockHint"
                                       Grid.Row="6"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="4"
                                       Margin="0,10,0,0"
                                       FontSize="11"
                                       loc:LocProps.Key="MatCard.StockHint"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="Actual stock quantities are updated by warehouse transactions."/>

                        </Grid>


                        <!-- =================================================
                             PANEL 3 — ACCOUNTS
                             ================================================= -->

                        <Grid x:Name="PanelAccounts"
                              Visibility="Collapsed">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="4"
                                       Text="Accounting Accounts"
                                       loc:LocProps.Key="MatCard.AccHeader"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="0,0,0,6"
                                       Foreground="{DynamicResource AccentDark}"/>


                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Inventory"
                                       loc:LocProps.Key="MatCard.AccInventory"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtAccInventory"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Style="{StaticResource CodeBox}"
                                     Margin="0,0,12,0"/>


                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="Sales"
                                       loc:LocProps.Key="MatCard.AccSales"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtAccSales"
                                     Grid.Row="1"
                                     Grid.Column="3"
                                     Style="{StaticResource CodeBox}"/>


                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Sales Return"
                                       loc:LocProps.Key="MatCard.AccSalesReturn"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtAccSalesReturn"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Style="{StaticResource CodeBox}"
                                     Margin="0,0,12,0"/>


                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="COGS"
                                       loc:LocProps.Key="MatCard.AccCogs"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtAccCogs"
                                     Grid.Row="2"
                                     Grid.Column="3"
                                     Style="{StaticResource CodeBox}"/>


                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Purchase"
                                       loc:LocProps.Key="MatCard.AccPurchase"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtAccPurchase"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Style="{StaticResource CodeBox}"
                                     Margin="0,0,12,0"/>


                            <TextBlock Grid.Row="3"
                                       Grid.Column="2"
                                       Text="Purchase Return"
                                       loc:LocProps.Key="MatCard.AccPurchaseReturn"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtAccPurchaseReturn"
                                     Grid.Row="3"
                                     Grid.Column="3"
                                     Style="{StaticResource CodeBox}"/>


                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="Expense"
                                       loc:LocProps.Key="MatCard.AccExpense"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtAccExpense"
                                     Grid.Row="4"
                                     Grid.Column="1"
                                     Style="{StaticResource CodeBox}"
                                     Margin="0,0,12,0"/>


                            <TextBlock Grid.Row="4"
                                       Grid.Column="2"
                                       Text="WIP"
                                       loc:LocProps.Key="MatCard.AccWip"
                                       Style="{StaticResource Lbl}"/>

                            <TextBox x:Name="TxtAccWip"
                                     Grid.Row="4"
                                     Grid.Column="3"
                                     Style="{StaticResource CodeBox}"/>


                            <StackPanel Grid.Row="5"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="4"
                                        Orientation="Horizontal"
                                        Margin="0,9,0,0">

                                <CheckBox x:Name="ChkAllowSale"
                                          Content="Allow Sale"
                                          loc:LocProps.Key="MatCard.AllowSale"
                                          Margin="0,0,14,0"
                                          IsChecked="True"/>

                                <CheckBox x:Name="ChkAllowPurchase"
                                          Content="Allow Purchase"
                                          loc:LocProps.Key="MatCard.AllowPurchase"
                                          Margin="0,0,14,0"
                                          IsChecked="True"/>

                                <CheckBox x:Name="ChkAllowReturn"
                                          Content="Allow Return"
                                          loc:LocProps.Key="MatCard.AllowReturn"
                                          Margin="0,0,14,0"
                                          IsChecked="True"/>

                                <CheckBox x:Name="ChkSalesBlocked"
                                          Content="Sales Blocked"
                                          loc:LocProps.Key="MatCard.SalesBlocked"/>

                            </StackPanel>

                        </Grid>


                        <!-- =================================================
                             PANEL 4 — EXTRA
                             ================================================= -->

                        <Grid x:Name="PanelExtra"
                              Visibility="Collapsed">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0"
                                       Text="Additional Specifications"
                                       loc:LocProps.Key="MatCard.ExtraHeader"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="0,0,0,5"
                                       Foreground="{DynamicResource AccentDark}"/>


                            <DataGrid x:Name="DgAttributes"
                                      Grid.Row="1"
                                      CanUserAddRows="True"
                                      CanUserDeleteRows="True"
                                      Language="en-US"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Binding="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                                        Width="120">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Group"
                                                       loc:LocProps.Key="MatCard.AttributesGroup"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                        Width="150">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Key"
                                                       loc:LocProps.Key="MatCard.AttributesKey"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                        Width="250">

                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Value"
                                                       loc:LocProps.Key="MatCard.AttributesValue"/>
                                        </DataGridTextColumn.Header>

                                    </DataGridTextColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </Grid>

                </Border>

            </Grid>

        </Grid>


        <!-- =============================================================
             FOOTER
             ============================================================= -->

        <Border Grid.Row="1"
                Background="{DynamicResource AccentLight}"
                BorderBrush="{DynamicResource FieldBorder}"
                BorderThickness="0,1,0,0"
                Padding="8,6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- Primary material action -->

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="BtnEdit"
                            Content="Edit Material"
                            loc:LocProps.Key="MatCard.EditMaterial"
                            Style="{StaticResource FootBtn}"
                            Click="Edit_Click"/>

                </StackPanel>


                <!-- Status -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="🏢"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"
                               Foreground="{DynamicResource AccentDark}"/>

                    <TextBlock x:Name="TxtStatusCompany"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="  ·  "
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="👤"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"
                               Foreground="{DynamicResource AccentDark}"/>

                    <TextBlock x:Name="TxtStatusUser"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"/>

                </StackPanel>


                <!-- Actions -->

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="BtnNew"
                            Content="New"
                            loc:LocProps.Key="Buttons.Add"
                            Style="{StaticResource FootBtn}"
                            Click="New_Click"/>

                    <Button x:Name="BtnSave"
                            Content="Save"
                            loc:LocProps.Key="Buttons.Save"
                            Style="{StaticResource FootBtn}"
                            FontWeight="SemiBold"
                            Click="Save_Click"/>

                    <Button x:Name="BtnCancel"
                            Content="Cancel"
                            loc:LocProps.Key="Buttons.Cancel"
                            Style="{StaticResource FootBtn}"
                            Click="Cancel_Click"/>

                    <Button x:Name="BtnDelete"
                            Content="Delete"
                            loc:LocProps.Key="Buttons.Delete"
                            Style="{StaticResource FootBtn}"
                            Click="Delete_Click"/>

                    <Button x:Name="BtnExcelExport"
                            Content="Excel Export"
                            Style="{StaticResource FootBtn}"
                            Click="ExcelExport_Click"/>

                    <Button x:Name="BtnExcelImport"
                            Content="Excel Import"
                            Style="{StaticResource FootBtn}"
                            Click="ExcelImport_Click"/>

                    <Button x:Name="BtnClose"
                            Content="Close"
                            loc:LocProps.Key="Buttons.Close"
                            Style="{StaticResource FootBtn}"
                            Click="Close_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</local:BaseWin>
