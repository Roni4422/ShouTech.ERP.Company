<local:BaseWin x:Class="ShouTech.App.Views.CoaWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShouTech.App.Views"
        Title="Chart of accounts"
        Width="1100" Height="780" MinWidth="760" MinHeight="620" SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Chart of accounts" FontSize="23" FontWeight="SemiBold" DockPanel.Dock="Right"
                       ToolTip="ToolTip"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,5" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                <DockPanel>
                    <TextBlock Text="⌕" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="ToolTip"/>
                    <TextBox x:Name="TxtSearch" BorderThickness="0" Background="Transparent" FontSize="14"
                             VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"
                             ToolTip="ToolTip"/>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Export ▾" Click="ExportMenu_Click" MinWidth="105"
                        Padding="12,7" ToolTip="ToolTip"/>
                <Button Content="Import ▾" Click="ImportMenu_Click" MinWidth="105" Margin="6,0,0,0"
                        Padding="12,7" ToolTip="ToolTip"/>
                <Button Content="↻" Click="Refresh_Click" MinWidth="42" Margin="6,0,0,0"
                        Padding="8,5" FontSize="17" ToolTip="ToolTip"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Text" FontWeight="SemiBold" ToolTip="ToolTip"/>
                </Border>

                <TreeView x:Name="TvAccounts" Grid.Row="1" Margin="8" Background="Transparent" BorderThickness="0"
                          SelectedItemChanged="TvAccounts_SelectedItemChanged">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:AccountNode}" ItemsSource="{Binding Children}">
                            <Border x:Name="AccountHeader" Padding="5,4" CornerRadius="5" Background="Transparent"
                                    ToolTip="{Binding ToolTipText}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <!-- Hover belongs to this account row only. Do not use TreeViewItem.IsMouseOver,
                                                 because that property is true for every ancestor when the pointer is over a child. -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayCode}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" Margin="18,0,8,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </Border>
                        </HierarchicalDataTemplate>

                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton x:Name="Expander" Grid.Column="0" Width="18" Height="22"
                                                              Padding="0" BorderThickness="0" Background="Transparent"
                                                              Foreground="{DynamicResource TextBrush}"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                              Focusable="False" Content="›" FontSize="18"
                                                              ToolTip="ToolTip"/>
                                                <Border x:Name="HeaderBorder" Grid.Column="1" Padding="2"
                                                        Background="Transparent" CornerRadius="5">
                                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                                      HorizontalAlignment="Stretch"/>
                                                </Border>
                                            </Grid>
                                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="22,0,0,0"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter TargetName="Expander" Property="Content" Value="⌄"/>
                                                <Setter TargetName="Expander" Property="ToolTip" Value=" Account"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                                                <Setter TargetName="PART_Header" Property="Opacity" Value="1"/>
                                            </Trigger>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.Resources>

                    <TreeView.ContextMenu>
                        <ContextMenu FlowDirection="RightToLeft">
                            <MenuItem Header="Account card" ToolTip="ToolTip" Click="OpenAccount_Click"/>
                            <MenuItem Header="Header" ToolTip="ToolTip" Click="AddChild_Click"/>
                            <Separator/>
                            <MenuItem Header="Header" ToolTip="ToolTip" Click="Statement_Click"/>
                            <MenuItem Header="Header" ToolTip="ToolTip" Click="Ledger_Click"/>
                            <Separator/>
                            <MenuItem Header="Header" ToolTip="ToolTip" Click="CopyCode_Click"/>
                            <MenuItem Header="Header" ToolTip="ToolTip" Click="CopyName_Click"/>
                            <MenuItem Header="Header" ToolTip="ToolTip" Click="OpenParent_Click"/>
                            <Separator/>
                            <MenuItem Header="Header" ToolTip="ToolTip" Click="ExpandBranch_Click"/>
                            <MenuItem Header="Header" ToolTip="ToolTip" Click="CollapseBranch_Click"/>
                            <MenuItem Header="Header" ToolTip="ToolTip" Click="ExpandAll_Click"/>
                            <MenuItem Header="Header" ToolTip="ToolTip" Click="CollapseAll_Click"/>
                            <Separator/>
                            <MenuItem Header="Print" ToolTip="Print Chart of accounts" Click="Print_Click"/>
                            <MenuItem Header="Refresh" ToolTip="ToolTip" Click="Refresh_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Close" Click="Close_Click" MinWidth="90" Padding="12,7"
                    ToolTip="ToolTip"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtSelected" Text="Text" VerticalAlignment="Center" Margin="0,0,18,0"
                           ToolTip="ToolTip"/>
                <TextBlock x:Name="TxtCount" Text="Text" VerticalAlignment="Center"
                           ToolTip="ToolTip"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:BaseWin>
