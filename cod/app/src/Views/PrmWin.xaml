<Window x:Class="ShouTech.App.Views.PrmWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User permissions"
        Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="14" Margin="0,0,0,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <TextBlock Text="User permissions" FontSize="21" FontWeight="SemiBold" DockPanel.Dock="Right"/>
                <TextBlock Text="{Binding UserId}" Margin="16,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding Status}" HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </DockPanel>
        </Border>
        <TabControl Grid.Row="1" ItemsSource="{Binding Tabs}" Margin="0,0,0,12" Background="{DynamicResource SurfaceBrush}">
            <TabControl.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Padding="8,4"/></DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7" Padding="12" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsAllowed, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Code}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Operation}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        <DockPanel Grid.Row="2">
            <TextBlock Text="Changes are saved as user exceptions only; role base permissions stay intact." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnCancel" Content="Cancel" Width="100" Height="36" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="BtnSave" Content="Save" Width="120" Height="36" Click="Save_Click" FontWeight="SemiBold"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
