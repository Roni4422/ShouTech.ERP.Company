<local:BaseWin x:Class="ShouTech.App.Views.SplWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShouTech.App.Views"
        Title="ShouTech ERP"
        Width="560"
        Height="330"
        MinWidth="560"
        MinHeight="330"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource AccentPrimary}"
        Foreground="{DynamicResource AccentPrimary}"
        FontFamily="Segoe UI, Tahoma"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid Margin="34,18,34,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="460">
                <TextBlock x:Name="txtAppName"
                           Text="ShouTech ERP"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                <TextBlock x:Name="txtAppNameEn"
                           Text="Enterprise Management Platform"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,8,0,0"/>
                <TextBlock x:Name="txtVersion"
                           Text="Version 10.6.0"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,14,0,0"/>
            </StackPanel>

            <ProgressBar x:Name="progressBar"
                         Grid.Row="1"
                         Height="4"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Foreground="{DynamicResource PrimaryBrush}"
                         Background="{DynamicResource SurfaceDarkBrush}"
                         BorderThickness="0"
                         Margin="0,8,0,12"/>

            <Grid Grid.Row="2">
                <TextBlock x:Name="txtStatus"
                           Text=""
                           FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="txtCopyright"
                           Text="© 2026 ShouTech"
                           FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</local:BaseWin>
