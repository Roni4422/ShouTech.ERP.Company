<Window x:Class="ShouTech.App.Views.ComWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ShouTech.App.Localization"
        Title="Select Company"
        loc:LocProps.WindowKey="CompanySelection.WindowTitle"
        Width="560"
        Height="330"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Tahoma"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
	<Window.Style>
        <Style TargetType="Window">
            <Setter Property="Height" Value="330"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HideUsernameField}" Value="True">
                    <Setter Property="Height" Value="330"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
	

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- Company list item                                     -->
        <!-- ===================================================== -->

        <Style x:Key="CompanyListItemStyle"
               TargetType="ListBoxItem">

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="Margin"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}"/>
					
			<Setter Property="BorderBrush" 
					Value="{DynamicResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <!-- Hover -->
                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{DynamicResource SurfaceLightBrush}"/>

                </Trigger>

                <!-- Selected -->
                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="{DynamicResource PrimaryTransparentBrush}"/>

                    <Setter Property="FontWeight"
                            Value="SemiBold"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- Company name                                           -->
        <!-- ===================================================== -->

        <Style x:Key="CompanyNameStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12.5"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

            <Setter Property="TextWrapping"
                    Value="NoWrap"/>

        </Style>


        <!-- ===================================================== -->
        <!-- Search box                                             -->
        <!-- ===================================================== -->

        <Style x:Key="CompanySearchStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="Padding"
                    Value="9,3"/>

            <Setter Property="FontSize"
                    Value="11.5"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{DynamicResource SurfaceLightBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- MAIN WINDOW                                                -->
    <!-- ========================================================= -->

    <Grid x:Name="rootSurfaceGrid"
          Background="{DynamicResource BackgroundBrush}"
          Margin="24,18,24,18">

        <DockPanel x:Name="rootDock"
                   LastChildFill="True">


            <!-- ================================================= -->
            <!-- MANAGEMENT PANEL                                   -->
            <!-- ================================================= -->

            <Border x:Name="mgmtPanel"
                    DockPanel.Dock="Right"
                    Visibility="Collapsed"
                    Width="150"
                    Margin="16,0,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    VerticalAlignment="Stretch">

                <DockPanel LastChildFill="False">

                    <TextBlock x:Name="txtMgmtTitle"
                               DockPanel.Dock="Top"
                               Text="Text"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Center"
                               Margin="0,0,0,12"/>


                    <StackPanel DockPanel.Dock="Top">

                        <Button x:Name="btnMgmtOpen"
                                Content="Open"
                                Height="32"
                                Margin="0,0,0,6"
                                Padding="8,3"
                                HorizontalAlignment="Stretch"
                                Click="BtnMgmtOpen_Click"
                                Style="{DynamicResource PrimaryButtonStyle}"/>


                        <Button x:Name="btnMgmtEdit"
                                Content="Edit"
                                Height="32"
                                Margin="0,0,0,6"
                                Padding="8,3"
                                HorizontalAlignment="Stretch"
                                Click="BtnMgmtEdit_Click"
                                Style="{DynamicResource SecondaryButtonStyle}"/>


                        <Button x:Name="btnMgmtDelete"
                                Height="32"
                                Margin="0,0,0,6"
                                Padding="8,3"
                                HorizontalAlignment="Stretch"
                                Click="BtnMgmtDeleteMenu_Click"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                ToolTip="ToolTip">

                            <Button.Content>

                                <Grid Width="120">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="txtDeleteLabel"
                                               Grid.Column="0"
                                               Text="Delete"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="▾"
                                               FontSize="11"
                                               Opacity="0.85"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Button.Content>


                            <Button.ContextMenu>

                                <ContextMenu x:Name="deleteContextMenu"
                                             Placement="Bottom">

                                    <MenuItem x:Name="miDeleteFromIndex"
                                              Header="Header"
                                              Click="BtnDeleteFromIndex_Click"/>

                                    <Separator/>

                                    <MenuItem x:Name="miDeleteFully"
                                              Header="Header"
                                              Click="BtnDeleteFully_Click"/>

                                </ContextMenu>

                            </Button.ContextMenu>

                        </Button>


                        <Button x:Name="btnMgmtReindex"
                                Content="Content"
                                Height="32"
                                Margin="0,0,0,6"
                                Padding="8,3"
                                HorizontalAlignment="Stretch"
                                Click="BtnMgmtReindex_Click"
                                Style="{DynamicResource SecondaryButtonStyle}"/>


                        <Button x:Name="btnMgmtDefault"
                                Content="Content"
                                Height="32"
                                Margin="0,0,0,6"
                                Padding="8,3"
                                HorizontalAlignment="Stretch"
                                Click="BtnMgmtDefault_Click"
                                Style="{DynamicResource SecondaryButtonStyle}"/>

                    </StackPanel>


                    <Button x:Name="btnMgmtClose"
                            Content="Close"
                            DockPanel.Dock="Bottom"
                            Height="32"
                            Margin="0,14,0,0"
                            Padding="8,3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Click="BtnMgmtClose_Click"
                            Style="{DynamicResource SecondaryButtonStyle}"/>

                </DockPanel>

            </Border>


            <!-- ================================================= -->
            <!-- MAIN CONTENT                                       -->
            <!-- ================================================= -->

            <Grid x:Name="contentGrid">

                <Grid.RowDefinitions>

                    <!-- Header -->
                    <RowDefinition Height="Auto"/>

                    <!-- Company list -->
                    <RowDefinition Height="*"/>

                    <!-- Footer -->
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ============================================= -->
                <!-- HEADER                                         -->
                <!-- ============================================= -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock x:Name="txtTitle"
                                   Text="Select Company"
                                   loc:LocProps.Key="CompanySelection.Title"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock x:Name="txtHint"
                                   Text="Text"
                                   loc:LocProps.Key="CompanySelection.Hint"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>

                    </StackPanel>

                </Grid>


                <!-- ============================================= -->
                <!-- COMPANY LIST                                   -->
                <!-- ============================================= -->

                <Grid x:Name="listPanel"
                      Grid.Row="1">

                    <Grid.RowDefinitions>

                        <!-- Search -->
                        <RowDefinition Height="Auto"/>

                        <!-- List -->
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- SEARCH -->

                    <TextBox x:Name="txtSearch"
                             Grid.Row="0"
                             Style="{StaticResource CompanySearchStyle}"
                             Margin="0,0,0,6"
                             TextChanged="TxtSearch_TextChanged"
                             ToolTip="Search companies"/>


                    <!-- COMPANY LIST -->

                    <ListBox x:Name="lstCompanies"
                             Grid.Row="1"
                             ItemsSource="{Binding FilteredCompanies}"
                             SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CompanyListItemStyle}"
                             MouseDoubleClick="LstCompanies_MouseDoubleClick"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <TextBlock Text="{Binding DisplayName}"
                                           Style="{StaticResource CompanyNameStyle}"
                                           HorizontalAlignment="Stretch"/>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>


                <!-- ============================================= -->
                <!-- EDIT PANEL                                     -->
                <!-- ============================================= -->

                <Border x:Name="editPanel"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>


                            <TextBlock x:Name="lblEditNameAr"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Text"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,6"/>

                            <TextBox x:Name="txtEditNameAr"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Height="28"
                                     Margin="0,0,0,6"/>


                            <TextBlock x:Name="lblEditNameEn"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Text"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,6"/>

                            <TextBox x:Name="txtEditNameEn"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Height="28"
                                     Margin="0,0,0,6"/>


                            <TextBlock x:Name="lblEditTax"
                                       Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Text"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,6"/>

                            <TextBox x:Name="txtEditTax"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Height="28"
                                     Margin="0,0,0,6"/>


                            <TextBlock x:Name="lblEditEmail"
                                       Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Text"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,6"/>

                            <TextBox x:Name="txtEditEmail"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Height="28"
                                     Margin="0,0,0,6"/>


                            <TextBlock x:Name="lblEditPhone"
                                       Grid.Row="4"
                                       Grid.Column="0"
                                       Text="Text"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,6"/>

                            <TextBox x:Name="txtEditPhone"
                                     Grid.Row="4"
                                     Grid.Column="1"
                                     Height="28"
                                     Margin="0,0,0,6"/>


                            <TextBlock x:Name="lblEditMobile"
                                       Grid.Row="5"
                                       Grid.Column="0"
                                       Text="Text"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,6"/>

                            <TextBox x:Name="txtEditMobile"
                                     Grid.Row="5"
                                     Grid.Column="1"
                                     Height="28"
                                     Margin="0,0,0,6"/>


                            <TextBlock x:Name="lblEditAddress"
                                       Grid.Row="6"
                                       Grid.Column="0"
                                       Text="Text"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,6"/>

                            <TextBox x:Name="txtEditAddress"
                                     Grid.Row="6"
                                     Grid.Column="1"
                                     Height="28"
                                     Margin="0,0,0,6"/>


                            <TextBlock x:Name="lblEditCity"
                                       Grid.Row="7"
                                       Grid.Column="0"
                                       Text="Text"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,6"/>

                            <TextBox x:Name="txtEditCity"
                                     Grid.Row="7"
                                     Grid.Column="1"
                                     Height="28"
                                     Margin="0,0,0,6"/>


                            <TextBlock x:Name="lblEditCountry"
                                       Grid.Row="8"
                                       Grid.Column="0"
                                       Text="Text"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,6"/>

                            <TextBox x:Name="txtEditCountry"
                                     Grid.Row="8"
                                     Grid.Column="1"
                                     Height="28"
                                     Margin="0,0,0,6"/>


                            <TextBlock x:Name="lblEditCurrency"
                                       Grid.Row="9"
                                       Grid.Column="0"
                                       Text="Text"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,6"/>

                            <TextBox x:Name="txtEditCurrency"
                                     Grid.Row="9"
                                     Grid.Column="1"
                                     Height="28"
                                     Margin="0,0,0,6"/>


                            <StackPanel Grid.Row="10"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,10,0,0">

                                <Button x:Name="btnEditSave"
                                        Content="Save"
                                        Width="100"
                                        Height="30"
                                        Margin="0,0,8,0"
                                        Click="BtnEditSave_Click"
                                        Style="{DynamicResource PrimaryButtonStyle}"/>

                                <Button x:Name="btnEditCancel"
                                        Content="Cancel"
                                        Width="100"
                                        Height="30"
                                        Click="BtnEditCancel_Click"
                                        Style="{DynamicResource SecondaryButtonStyle}"/>

                            </StackPanel>

                        </Grid>

                    </ScrollViewer>

                </Border>


                <!-- ============================================= -->
                <!-- FOOTER                                         -->
                <!-- ============================================= -->

                <Grid x:Name="btnBar"
                      Grid.Row="2"
                      Margin="0,10,0,0"
                      HorizontalAlignment="Stretch">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="100"/>

                        <ColumnDefinition Width="10"/>

                        <ColumnDefinition Width="100"/>

                    </Grid.ColumnDefinitions>


                    <!-- Setup Wizard -->

                    <Button x:Name="btnSetupWizard"
                            Grid.Column="0"
                            Content="Content"
                            Height="30"
                            Padding="10,0"
                            FontWeight="SemiBold"
                            Click="BtnSetupWizard_Click"
                            Style="{DynamicResource SecondaryButtonStyle}"/>


                    <!-- OK -->

                    <Button x:Name="btnOk"
                            Grid.Column="2"
                            Content="OK"
                            loc:LocProps.Key="CompanySelection.Ok"
                            Height="32"
                            FontWeight="SemiBold"
                            Click="BtnContinue_Click"
                            IsDefault="True"
                            Style="{DynamicResource PrimaryButtonStyle}"/>


                    <!-- Cancel -->

                    <Button x:Name="btnCancel"
                            Grid.Column="4"
                            Content="Cancel"
                            loc:LocProps.Key="Buttons.Cancel"
                            Height="32"
                            Click="BtnCancel_Click"
                            IsCancel="True"
                            Style="{DynamicResource SecondaryButtonStyle}"/>

                </Grid>

            </Grid>

        </DockPanel>

    </Grid>

</Window>
